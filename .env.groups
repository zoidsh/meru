# Checks that run once every value is resolved. A file's own root decorators
# run before its imports' and varlock walks imports last to first, so this file
# is imported first in `.env.schema` to run after `.env.1password`'s `@initOp`;
# a check placed earlier resolves an `op()` before 1Password is signed in to.
# @plugin(@timche/varlock-require-all-or-none)
# @requireAllOrNone($AZURE_TENANT_ID, $AZURE_CLIENT_ID, $AZURE_CLIENT_SECRET)
# @requireAllOrNone($CSC_LINK, $CSC_KEY_PASSWORD, $APPLE_ID, $APPLE_APP_SPECIFIC_PASSWORD, $APPLE_TEAM_ID, $APPLE_PROVISIONING_PROFILE)
# ---
