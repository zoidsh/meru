#. Under the Unified inbox title: how many unread messages the list below shows
#. placeholder {0}: rows.length
#: src/shell/inbox.tsx
msgid "{0, plural, one {# message} other {# messages}}"
msgstr "{0, plural, one {# message} other {# messages}}"

#. Accessible name of a profile's button in the title bar, read by screen readers, while its inbox has unread mail; {name} is the profile's name, # how many messages are unread
#: src/shell/titlebar.tsx
msgid "{count, plural, one {{name}, # unread message} other {{name}, # unread messages}}"
msgstr "{count, plural, one {{name}, # unread message} other {{name}, # unread messages}}"

#. Accessible name of a profile's button in the title bar, read by screen readers, while the profile sleeps and its inbox has unread mail; {name} is the profile's name, # how many messages are unread
#: src/shell/titlebar.tsx
msgid "{count, plural, one {{name}, asleep, # unread message} other {{name}, asleep, # unread messages}}"
msgstr "{count, plural, one {{name}, asleep, # unread message} other {{name}, asleep, # unread messages}}"

#. Title of the one notification for several emails that arrived at once in a profile, which opens its inbox when clicked
#: src/main/notifications.ts
msgid "{count, plural, one {# new message} other {# new messages}}"
msgstr "{count, plural, one {# new message} other {# new messages}}"

#. How many settings a profile sets for itself, beside its name in the Settings scope switcher's menu
#: src/settings/scope-tabs.tsx
msgid "{count, plural, one {# override} other {# overrides}}"
msgstr "{count, plural, one {# override} other {# overrides}}"

#. Read out by a screen reader for the unread badge on Meru's taskbar button on Windows
#: src/main/badge.ts
msgid "{count, plural, one {# unread message} other {# unread messages}}"
msgstr "{count, plural, one {# unread message} other {# unread messages}}"

#. Description of the Trusted sites row in Settings; # counts the sites whose links open in the default browser without Meru asking first
#: src/settings/privacy-page.tsx
msgid "{count, plural, one {Links to # site open without asking.} other {Links to # sites open without asking.}}"
msgstr "{count, plural, one {Links to # site open without asking.} other {Links to # sites open without asking.}}"

#. Muted line under a setting in Settings' All profiles, before a badge naming each profile that sets its own value; # is how many
#: src/settings/scope.ts
msgid "{count, plural, one {Set differently for # profile:} other {Set differently for # profiles:}}"
msgstr "{count, plural, one {Set differently for # profile:} other {Set differently for # profiles:}}"

#. In the footer of the main window during the Meru Pro trial; # counts the calendar days left, two or more
#: src/shell/trial-footer.tsx
msgid "{days, plural, one {Pro trial ends in # day} other {Pro trial ends in # days}}"
msgstr "{days, plural, one {Pro trial ends in # day} other {Pro trial ends in # days}}"

#. About Meru Pro (in Settings) during the trial; # counts the calendar days left, two or more
#: src/shared/license-status.ts
msgid "{days, plural, one {Your trial ends in # day.} other {Your trial ends in # days.}}"
msgstr "{days, plural, one {Your trial ends in # day.} other {Your trial ends in # days.}}"

#. How much of a running download has arrived, in the Downloads card, such as 12.4 of 48 MB; done is a number, total a size with its unit
#: src/shell/downloads.tsx
msgid "{done} of {total}"
msgstr "{done} of {total}"

#. On the Shortcuts page of Settings, the keys of the first and the last of a numbered set of commands, such as ⌃⇧1 to ⌃⇧9
#: src/settings/shortcuts-page.tsx
msgid "{first} to {last}"
msgstr "{first} to {last}"

#. Description of the Do Not Disturb switch in Settings while it is off; {holds} is what it does, such as Silences all notifications. The moon is the Do Not Disturb button in the main window's title bar
#: src/settings/do-not-disturb.ts
msgid "{holds} You can also turn it on for a while from the moon in the title bar."
msgstr "{holds} You can also turn it on for a while from the moon in the title bar."

#. Item in the Do Not Disturb menu that holds notifications for this many hours
#: src/main/commands.ts
msgid "{hours, plural, one {For # Hour} other {For # Hours}}"
msgstr "{hours, plural, one {For # Hour} other {For # Hours}}"

#. Tooltip of a control that has a keyboard shortcut: {label} is what the control does, {shortcut} its keys as the platform writes them, such as ⌘R or Ctrl+R
#: src/shell/shortcut-title.ts
msgid "{label} ({shortcut})"
msgstr "{label} ({shortcut})"

#. Label of a disabled menu item on the free version, saying it needs Meru Pro; {label} is the item's own label, such as Split Right
#: src/main/menu-labels.ts
msgid "{label} (Pro)"
msgstr "{label} (Pro)"

#. Shown on an unread badge when more messages are unread than the number before the plus
#. Shown on an unread badge, on a profile's tab in the title bar or on Gmail's tab, when more messages are unread than the number before the plus
#: src/main/badge.ts
#: src/shell/unread-badge.tsx
msgid "{MAX_SHOWN_UNREAD}+"
msgstr "{MAX_SHOWN_UNREAD}+"

#. Item in the Do Not Disturb menu that holds notifications for this many minutes
#: src/main/commands.ts
msgid "{minutes, plural, one {For # Minute} other {For # Minutes}}"
msgstr "{minutes, plural, one {For # Minute} other {For # Minutes}}"

#. What a menu's button in Settings reads with more items checked than it names; {shownNames} lists the first three, as System language, German, French, and # counts the rest
#: src/settings/checked-summary.ts
msgid "{more, plural, one {{shownNames} and # more} other {{shownNames} and # more}}"
msgstr "{more, plural, one {{shownNames} and # more} other {{shownNames} and # more}}"

#. Tooltip of a profile's button in the title bar while the profile sleeps: its pages are closed, its mail still checked; {name} is the profile's name
#: src/shell/titlebar.tsx
msgid "{name} · asleep"
msgstr "{name} · asleep"

#. Tooltip of a profile's button in the title bar while the profile sleeps and its Google account is signed out; {name} is the profile's name
#: src/shell/titlebar.tsx
msgid "{name} · asleep · sign in required"
msgstr "{name} · asleep · sign in required"

#. A profile in the tray's menu with its unread count; {name} is the profile's name and {count} the number of unread messages
#: src/main/tray.ts
msgid "{name} ({count})"
msgstr "{name} ({count})"

#. Heading shown in place of a tab's page that could not load; {name} is the Google app, such as Gmail or Calendar
#: src/shell/tab-problem.tsx
msgid "{name} couldn’t load"
msgstr "{name} couldn’t load"

#. Read by screen readers after a profile is moved in Settings' list of profiles; {place} is its new place from 1 and {count} how many profiles there are
#: src/settings/profiles-page.tsx
msgid "{name} is now {place} of {count} in the title bar."
msgstr "{name} is now {place} of {count} in the title bar."

#. Second sentence after an action in the unified inbox failed because the profile's Google account is signed out; {name} is the profile
#: src/shell/inbox.tsx
msgid "{name} is signed out."
msgstr "{name} is signed out."

#. Explanation under the offline heading in place of a tab's page; {name} is the Google app, such as Gmail or Calendar
#: src/shell/tab-problem.tsx
msgid "{name} loads by itself when you’re back online."
msgstr "{name} loads by itself when you’re back online."

#. Heading shown in place of a tab's page that crashed; {name} is the Google app, such as Gmail or Calendar
#: src/shell/tab-problem.tsx
msgid "{name} stopped working"
msgstr "{name} stopped working"

#. Accessible name of a profile's button in the title bar, read by screen readers, while the profile sleeps: its pages are closed, its mail still checked; {name} is the profile's name
#: src/shell/titlebar.tsx
msgid "{name}, asleep"
msgstr "{name}, asleep"

#. Accessible name of a profile's button in the title bar, read by screen readers, while the profile sleeps and its Google account is signed out; {name} is the profile's name
#: src/shell/titlebar.tsx
msgid "{name}, asleep, sign in required"
msgstr "{name}, asleep, sign in required"

#. Accessible name and tooltip of a profile's button in the title bar while its Google account is signed out; {name} is the profile's name
#: src/shell/titlebar.tsx
msgid "{name}, sign in required"
msgstr "{name}, sign in required"

#. Description under Sign in required in the page area of a profile with no Google app open; {name} is the profile's name
#: src/shell/nothing-open.tsx
msgid "{name}'s Google account is signed out, so its mail is not checked."
msgstr "{name}'s Google account is signed out, so its mail is not checked."

#. The find bar's count: {ordinal} is the match shown, {matches} how many the page has, such as 2/14; 0/0 with none
#: src/shell/find-bar.tsx
msgid "{ordinal}/{matches}"
msgstr "{ordinal}/{matches}"

#. Title of the error dialog shown when the app's window keeps failing to draw and the app quits; {productName} is the app's name
#: src/main/shell-recovery.ts
msgid "{productName} could not draw its window"
msgstr "{productName} could not draw its window"

#. Title of the error dialog shown when the app fails to open; {productName} is the app's name
#: src/main/failures.ts
msgid "{productName} could not start"
msgstr "{productName} could not start"

#. Second line of a finished download in the Downloads card, such as 2.4 MB · 2 hours ago; {saved} is its size with its unit, {when} when it started, such as 2 hours ago or yesterday
#: src/shell/downloads.tsx
msgid "{saved} · {when}"
msgstr "{saved} · {when}"

#. Read by screen readers on the title bar's Downloads button while downloads run, such as 40% downloaded
#: src/shell/downloads.tsx
msgid "{share} downloaded"
msgstr "{share} downloaded"

#. A window of quiet hours in the Settings caption naming the value under All profiles; {start} and {end} are times such as 22:00 and 07:00, {days} when, such as every day or weekdays
#: src/settings/scope.ts
msgid "{start}–{end} {days}"
msgstr "{start}–{end} {days}"

#. Tooltip of a tile in the sidebar while its tab sleeps: put to sleep, or not opened yet since Meru started; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "{title} · asleep"
msgstr "{title} · asleep"

#. Tooltip of Gmail's tile in the sidebar while it sleeps and the profile's Google account is signed out; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "{title} · asleep · sign in required"
msgstr "{title} · asleep · sign in required"

#. Tooltip of a tile in the sidebar whose tab was moved to a window of its own; a click brings that window forward; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "{title} · in its own window"
msgstr "{title} · in its own window"

#. Tooltip of Gmail's tile in the sidebar while the profile's Google account is signed out; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "{title} · sign in required"
msgstr "{title} · sign in required"

#. Heading in place of the selected tab's page after it was put to sleep; {title} is the tab's title or else its Google app's name
#: src/shell/sleeping-tab.tsx
msgid "{title} is sleeping"
msgstr "{title} is sleeping"

#. Said by screen readers when a tab cannot move up with the keyboard, being first among the pinned tabs or the other tabs; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "{title}, already first"
msgstr "{title}, already first"

#. Said by screen readers when a tab cannot move down with the keyboard, being last among the pinned tabs or the other tabs; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "{title}, already last"
msgstr "{title}, already last"

#. Said by screen readers after a tab is moved with the keyboard; {title} is the tab's title, {position} its place among the pinned tabs or the other tabs, a split's box counting as one, and {count} how many places there are
#: src/shell/tab-strip.tsx
msgid "{title}, position {position} of {count}"
msgstr "{title}, position {position} of {count}"

#. Said by screen readers after the title of a tab in the sidebar's split view box; {told} is what is said of it otherwise, such as Asleep
#: src/shell/tab-strip.tsx
msgid "{told}, in split view"
msgstr "{told}, in split view"

#. Said by screen readers after the title of a tab in the sidebar's split view box while one pane shows alone; {told} is what is said of it otherwise, such as Asleep
#: src/shell/tab-strip.tsx
msgid "{told}, in split view, maximized"
msgstr "{told}, in split view, maximized"

#. Below the unified inbox when a profile has more unread mail than the list shows, since Gmail lists only the newest; {name} is the profile, {listed} how many are shown, # how many are unread
#: src/shell/inbox.tsx
msgid "{unreadCount, plural, one {{name}: the newest {listed} of # unread} other {{name}: the newest {listed} of # unread}}"
msgstr "{unreadCount, plural, one {{name}: the newest {listed} of # unread} other {{name}: the newest {listed} of # unread}}"

#. Second line of a download in the Downloads card that was interrupted, such as Failed · 2 hours ago, Failed in the destructive color; {when} is when it started, such as 2 hours ago or yesterday
#: src/shell/downloads.tsx
msgid "<0>Failed</0> · {when}"
msgstr "<0>Failed</0> · {when}"

#. Option of the Sleep after menu in Settings: how long a tab goes unused before it sleeps
#: src/settings/tabs-apps-page.tsx
msgid "1 hour"
msgstr "1 hour"

#. Option of the Sleep after menu in Settings: how long a tab goes unused before it sleeps
#: src/settings/tabs-apps-page.tsx
msgid "3 hours"
msgstr "3 hours"

#. Option of the Sleep after menu in Settings: how long a tab goes unused before it sleeps
#: src/settings/tabs-apps-page.tsx
msgid "30 minutes"
msgstr "30 minutes"

#. Option of the Sleep after menu in Settings: how long a tab goes unused before it sleeps
#: src/settings/tabs-apps-page.tsx
msgid "6 hours"
msgstr "6 hours"

#. Read by screen readers on the title bar's Downloads button, green once a download finished and the list has not been opened since
#: src/shell/downloads.tsx
msgid "A download finished"
msgstr "A download finished"

#. Name of the Settings section showing Meru's version and the operating system, in its list and as its title
#: src/settings/app.tsx
msgid "About"
msgstr "About"

#. Menu item in the macOS app menu that shows the app's version; {appName} is the app's name
#: src/main/application-menu.ts
msgid "About {appName}"
msgstr "About {appName}"

#. Button in the license key dialog that checks the key and, once it is accepted, unlocks Meru Pro on this computer
#: src/shared/license-dialog.tsx
msgid "Activate"
msgstr "Activate"

#. Menu item in the View menu that sets the page's zoom back to 100%
#: src/main/application-menu.ts
msgid "Actual Size"
msgstr "Actual Size"

#. Button under the Settings list of quiet hours that adds quiet hours, a window from 22:00 to 07:00 every day
#: src/settings/quiet-hours-field.tsx
msgid "Add"
msgstr "Add"

#. Button under Settings' list of profiles that adds one and opens its page
#: src/settings/profiles-page.tsx
msgid "Add profile"
msgstr "Add profile"

#. Name of the group of fields in Settings that adds a saved search to a profile
#: src/settings/saved-searches-card.tsx
msgid "Add saved search"
msgstr "Add saved search"

#. Button on a profile's page in Settings that opens the fields to add a saved search
#: src/settings/saved-searches-card.tsx
msgid "Add search"
msgstr "Add search"

#. Description of the Tint with profile color switch in Settings
#: src/settings/appearance-page.tsx
msgid "Adds a touch of the profile color to the title bar and sidebar."
msgstr "Adds a touch of the profile color to the title bar and sidebar."

#. Name of the Settings section for hardware acceleration, the settings file and clearing the cache, in its list and as its title
#: src/settings/app.tsx
msgid "Advanced"
msgstr "Advanced"

#. A window of quiet hours whose start and end are the same, so it holds the whole day, in the Settings caption naming the value under All profiles; {days} is when, such as every day or weekdays
#: src/settings/scope.ts
msgid "all day {days}"
msgstr "all day {days}"

#. First segment of the scope switcher atop a Settings page: the app setting every profile uses unless it sets its own
#: src/settings/scope-tabs.tsx
msgid "All profiles"
msgstr "All profiles"

#. Option of the Sleep idle tabs menu in Settings: every tab, pinned or not, sleeps once idle
#: src/settings/tabs-apps-page.tsx
msgid "All tabs"
msgstr "All tabs"

#. Label of the switch in Settings that shows a notification for new mail
#: src/settings/notifications-page.tsx
msgid "Allow notifications"
msgstr "Allow notifications"

#. Label over the band along the window's edge that lights up while a tab is dragged near it; dropping it puts the tab there beside every pane
#: src/shell/drop-zone.tsx
msgid "Along the whole view"
msgstr "Along the whole view"

#. Description of the License key row on the Meru Pro page of Settings with no key entered
#: src/settings/pro-page.tsx
msgid "Already bought Meru Pro? Enter your key to unlock it."
msgstr "Already bought Meru Pro? Enter your key to unlock it."

#. The Alt key, as a screen reader says it in a keyboard shortcut
#: src/main/shortcuts-page.ts
msgid "Alt"
msgstr "Alt"

#. Label of the menu in Settings choosing the Google apps whose links always open in the default browser rather than in Meru
#: src/settings/tabs-apps-page.tsx
msgid "Always open in your default browser"
msgstr "Always open in your default browser"

#. Checkbox in the dialog that asks before a link opens in the default browser; {name} is the site, such as example.com, which is then listed under Trusted sites in Settings
#: src/main/link-opener.ts
msgid "Always open links to {name} without asking"
msgstr "Always open links to {name} without asking"

#. Name of a profile's color
#: src/settings/profile-page.tsx
msgid "Amber"
msgstr "Amber"

#. After the badges naming the first three profiles that set their own value of a setting in Settings; {more} is how many others do
#: src/settings/row-scope.tsx
msgid "and {more} more"
msgstr "and {more} more"

#. Name of the Settings section for the theme, the profile tint and the title bar's buttons, in its list and as its title
#: src/settings/app.tsx
msgid "Appearance"
msgstr "Appearance"

#. Button on a new email notification that archives the email. Gmail's own word for the action
#: src/main/notifications.ts
msgid "Archive"
msgstr "Archive"

#. Button on a message in the unified inbox that archives it. Gmail's own word for the action
#: src/shell/inbox.tsx
msgctxt "inbox action"
msgid "Archive"
msgstr "Archive"

#. Choice of the Copy code menu in Settings: the code is copied as soon as the email with it arrives
#: src/settings/gmail-page.tsx
msgid "As soon as it arrives"
msgstr "As soon as it arrives"

#. Label of the switch in Settings that has Meru ask before a link from a page opens in the default browser
#: src/settings/privacy-page.tsx
msgid "Ask before opening links"
msgstr "Ask before opening links"

#. Label of the switch in Settings that has each download open the system's save dialog
#: src/settings/general-page.tsx
msgid "Ask where to save each file"
msgstr "Ask where to save each file"

#. Badge on a sleeping profile's row in Settings' list of profiles
#. Said by screen readers after a sidebar row's title while its tab sleeps: put to sleep, or not opened yet since Meru started
#: src/settings/profiles-page.tsx
#: src/shell/tab-strip.tsx
msgid "Asleep"
msgstr "Asleep"

#. Description of Sleep on a profile's page in Settings, whose switch is disabled since every other profile sleeps
#: src/settings/profile-page.tsx
msgid "At least one profile has to stay awake."
msgstr "At least one profile has to stay awake."

#. Description of Enabled on the page of the only enabled profile in Settings, whose switch is disabled
#: src/settings/profile-page.tsx
msgid "At least one profile has to stay on."
msgstr "At least one profile has to stay on."

#. Accessible name and tooltip of the title bar button that goes to the page the tab showed before
#. Accessible name of the Settings window's button that goes back to the page shown before, a section or a profile's page
#. Menu item in the View menu that goes to the page the selected tab showed before
