#. Accessible name of a profile's tab in the title bar while its inbox has unread mail, read by screen readers: the profile's name, then how many messages are unread
#: src/shell/app.tsx
msgid "{count, plural, one {{name}, # unread message} other {{name}, # unread messages}}"
msgstr "{count, plural, one {{name}, # unread message} other {{name}, # unread messages}}"

#. Shown on a profile's unread badge in the title bar when more messages are unread than the number before the plus
#: src/shell/app.tsx
msgid "{MAX_SHOWN_UNREAD}+"
msgstr "{MAX_SHOWN_UNREAD}+"

#. Heading shown in place of a tab's page that could not load; {name} is the app, such as Gmail or Calendar
#: src/shell/tab-strip.tsx
msgid "{name} couldn’t load"
msgstr "{name} couldn’t load"

#. Explanation under the offline heading in place of a tab's page; {name} is the app, such as Gmail or Calendar
#: src/shell/tab-strip.tsx
msgid "{name} loads by itself when you’re back online."
msgstr "{name} loads by itself when you’re back online."

#. Heading shown in place of a tab's page that crashed; {name} is the app, such as Gmail or Calendar
#: src/shell/tab-strip.tsx
msgid "{name} stopped working"
msgstr "{name} stopped working"

#. Title of the error dialog shown when the app fails to open; {productName} is the app's name
#: src/main/failures.ts
msgid "{productName} could not start"
msgstr "{productName} could not start"

#. Menu item in the macOS app menu that shows the app's version; {appName} is the app's name
#: src/main/application-menu.ts
msgid "About {appName}"
msgstr "About {appName}"

#. Menu item in the View menu that sets the page's zoom back to 100%
#: src/main/application-menu.ts
msgid "Actual Size"
msgstr "Actual Size"

#. Accessible name of the plus button in the title bar that adds a profile, read by screen readers
#: src/shell/app.tsx
msgid "Add profile"
msgstr "Add profile"

#. Menu item in the Window menu that adds a profile, signed in to no account yet, and selects it
#: src/main/commands.ts
msgid "Add Profile"
msgstr "Add Profile"

#. Menu item in the macOS Window menu
#: src/main/application-menu.ts
msgid "Bring All to Front"
msgstr "Bring All to Front"

#. Button in the dialog that confirms removing a profile, which keeps it
#: src/main/profile-copy.ts
msgid "Cancel"
msgstr "Cancel"

#. Menu item in the View menu that chooses the design where pages run edge to edge, as in earlier versions
#: src/main/commands.ts
msgctxt "design"
msgid "Classic"
msgstr "Classic"

#. Menu item in the Window menu that closes the window
#: src/main/application-menu.ts
msgid "Close"
msgstr "Close"

#. Accessible name of the cross on a tab that closes it; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "Close {title}"
msgstr "Close {title}"

#. Menu item in the Tabs menu that closes the selected tab
#: src/main/commands.ts
msgid "Close Tab"
msgstr "Close Tab"

#. Menu item in the macOS Window menu
#: src/main/application-menu.ts
msgid "Close Window"
msgstr "Close Window"

#. Accessible name of the window's main area, below the title bar, read by screen readers
#: src/shell/app.tsx
msgid "Content"
msgstr "Content"

#. Menu item in the Edit menu
#: src/main/application-menu.ts
msgid "Copy"
msgstr "Copy"

#. Said by screen readers after a tab's title when its page could not load
#: src/shell/tab-strip.tsx
msgid "Couldn’t load"
msgstr "Couldn’t load"

#. Menu item in the Edit menu
#: src/main/application-menu.ts
msgid "Cut"
msgstr "Cut"

#. Name of the first profile until the person renames it, shown in the title bar
#: src/main/profile-copy.ts
msgctxt "profile name"
msgid "Default"
msgstr "Default"

#. Menu item in the Edit menu that deletes the selected text
#: src/main/application-menu.ts
msgid "Delete"
msgstr "Delete"

#. Name of the Edit menu
#: src/main/application-menu.ts
msgid "Edit"
msgstr "Edit"

#. Name of the Help menu
#: src/main/application-menu.ts
msgid "Help"
msgstr "Help"

#. Menu item in the macOS app menu that hides the app; {appName} is the app's name
#: src/main/application-menu.ts
msgid "Hide {appName}"
msgstr "Hide {appName}"

#. Menu item in the macOS app menu that hides every other app
#: src/main/application-menu.ts
msgid "Hide Others"
msgstr "Hide Others"

#. Explanation under the heading in place of a tab's page that crashed
#: src/shell/tab-strip.tsx
msgid "Its page quit unexpectedly. Reload it to carry on."
msgstr "Its page quit unexpectedly. Reload it to carry on."

#. Said by screen readers after a tab's title while its page loads
#: src/shell/tab-strip.tsx
msgid "Loading"
msgstr "Loading"

#. Explanation under the heading in place of a tab's page that could not load
#: src/shell/tab-strip.tsx
msgid "Meru keeps trying by itself."
msgstr "Meru keeps trying by itself."

#. Explanation in the dialog that confirms removing a profile
#: src/main/profile-copy.ts
msgid "Meru signs out of this profile and deletes its data on this device. Your Google account isn't affected."
msgstr "Meru signs out of this profile and deletes its data on this device. Your Google account isn't affected."

#. Menu item in the Window menu
#: src/main/application-menu.ts
msgid "Minimize"
msgstr "Minimize"

#. Menu item in the View menu that chooses the design where pages sit inset with rounded corners
#: src/main/commands.ts
msgctxt "design"
msgid "Modern"
msgstr "Modern"

#. Menu item in the Edit menu
#: src/main/application-menu.ts
msgid "Paste"
msgstr "Paste"

#. Menu item in the Edit menu that pastes text without its formatting
#: src/main/application-menu.ts
msgid "Paste and Match Style"
msgstr "Paste and Match Style"

#. Name given to a newly added profile, where {n} is a number from 2 up; the person can rename it later
#: src/main/profile-copy.ts
msgid "Profile {n}"
msgstr "Profile {n}"

#. Accessible name of the row of profile tabs in the title bar, read by screen readers
#: src/shell/app.tsx
msgid "Profiles"
msgstr "Profiles"

#. Menu item that quits the app; {appName} is the app's name, such as Meru
#: src/main/application-menu.ts
msgid "Quit {appName}"
msgstr "Quit {appName}"

#. Menu item in the Edit menu
#: src/main/application-menu.ts
msgid "Redo"
msgstr "Redo"

#. Button in place of a tab's page that crashed, which loads the page again
#. Menu item in the View menu that loads the selected tab again
#: src/main/commands.ts
#: src/shell/tab-strip.tsx
msgid "Reload"
msgstr "Reload"

#. Question in the dialog that confirms removing a profile; {name} is the profile's name
#: src/main/profile-copy.ts
msgid "Remove {name}?"
msgstr "Remove {name}?"

#. Item in a profile's context menu in the title bar that asks to remove the profile; {name} is the profile's name
#: src/main/profile-copy.ts
msgid "Remove {name}…"
msgstr "Remove {name}…"

#. Button in the dialog that confirms removing a profile
#: src/main/profile-copy.ts
msgid "Remove Profile"
msgstr "Remove Profile"

#. Heading of the small panel over the page with a field for a profile's new name, and the field's label
#: src/shell/overlay.tsx
msgid "Rename profile"
msgstr "Rename profile"

#. Menu item in the Window menu that shows a field to change the selected profile's name
#: src/main/commands.ts
msgid "Rename Profile…"
msgstr "Rename Profile…"

#. Item in a profile's context menu in the title bar that shows a field to change the profile's name
#: src/main/profile-copy.ts
msgctxt "profile"
msgid "Rename…"
msgstr "Rename…"

#. Menu item in the Edit menu
#: src/main/application-menu.ts
msgid "Select All"
msgstr "Select All"

#. Menu item in the Window menu that selects the profile right of the selected one, or the first after the last
#: src/main/commands.ts
msgid "Select Next Profile"
msgstr "Select Next Profile"

#. Menu item in the Tabs menu that selects the tab below the selected one, or the first after the last
#: src/main/commands.ts
msgid "Select Next Tab"
msgstr "Select Next Tab"

#. Menu item in the Window menu that selects the profile left of the selected one, or the last before the first
#: src/main/commands.ts
msgid "Select Previous Profile"
msgstr "Select Previous Profile"

#. Menu item in the Tabs menu that selects the tab above the selected one, or the last before the first
#: src/main/commands.ts
msgid "Select Previous Tab"
msgstr "Select Previous Tab"

#. The macOS app menu's submenu of system services, named as macOS names it
#: src/main/application-menu.ts
msgid "Services"
msgstr "Services"

#. Menu item in the macOS app menu that shows every hidden app again
#: src/main/application-menu.ts
msgid "Show All"
msgstr "Show All"

#. Said by screen readers after a tab's title when its page crashed
#: src/shell/tab-strip.tsx
msgid "Stopped working"
msgstr "Stopped working"

#. Accessible name of the list of the profile's tabs down the left of the window, read by screen readers
#. Name of the menu of commands on the selected profile's tabs
#: src/main/application-menu.ts
#: src/shell/tab-strip.tsx
msgid "Tabs"
msgstr "Tabs"

#. Shown when the app is started on data that a later version of the app wrote, which this version cannot read
#: src/main/store-file.ts
msgid "This data was saved by a newer version. Open it with that version, or update to it."
msgstr "This data was saved by a newer version. Open it with that version, or update to it."

#. Accessible name of the strip across the top of the window, read by screen readers
#: src/shell/app.tsx
msgid "Title bar"
msgstr "Title bar"

#. Menu item in the View menu that makes the window fill the screen, or stop filling it
#: src/main/application-menu.ts
msgid "Toggle Full Screen"
msgstr "Toggle Full Screen"

#. Button in place of a tab's page that could not load, which tries to load it again now
#: src/shell/tab-strip.tsx
msgid "Try again"
msgstr "Try again"

#. Label of the disabled button in place of a tab's page while it tries to load the page again
#: src/shell/tab-strip.tsx
msgid "Trying again…"
msgstr "Trying again…"

#. Menu item in the Edit menu
#: src/main/application-menu.ts
msgid "Undo"
msgstr "Undo"

#. Menu item in the View menu, checked while the window's sidebar and title bar let the desktop show through, blurred, as macOS sidebars do
#: src/main/commands.ts
msgid "Vibrancy"
msgstr "Vibrancy"

#. Name of the View menu
#: src/main/application-menu.ts
msgid "View"
msgstr "View"

#. Name of the Window menu
#: src/main/application-menu.ts
msgid "Window"
msgstr "Window"

#. Heading shown in place of a tab's page that could not load because the computer is offline
#: src/shell/tab-strip.tsx
msgid "You’re offline"
msgstr "You’re offline"

#. Menu item in the macOS Window menu that toggles the window between its size and filling the screen
#: src/main/application-menu.ts
msgid "Zoom"
msgstr "Zoom"

#. Menu item in the View menu that makes the page larger
#: src/main/application-menu.ts
msgid "Zoom In"
msgstr "Zoom In"

#. Menu item in the View menu that makes the page smaller
#: src/main/application-menu.ts
msgid "Zoom Out"
msgstr "Zoom Out"
