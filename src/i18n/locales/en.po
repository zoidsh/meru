#. Under the Unified inbox title: how many unread messages the list below shows
#. placeholder {0}: rows.length
#: src/shell/inbox.tsx
msgid "{0, plural, one {# message} other {# messages}}"
msgstr "{0, plural, one {# message} other {# messages}}"

#. Accessible name of a profile's button in the title bar, read by screen readers, while its inbox has unread mail; {name} is the profile's name, # how many messages are unread
#: src/shell/titlebar.tsx
msgid "{count, plural, one {{name}, # unread message} other {{name}, # unread messages}}"
msgstr "{count, plural, one {{name}, # unread message} other {{name}, # unread messages}}"

#. Accessible name of a profile's button in the title bar, read by screen readers, while the profile sleeps and its inbox has unread mail; {name} is the profile's name, # how many messages are unread
#: src/shell/titlebar.tsx
msgid "{count, plural, one {{name}, asleep, # unread message} other {{name}, asleep, # unread messages}}"
msgstr "{count, plural, one {{name}, asleep, # unread message} other {{name}, asleep, # unread messages}}"

#. Title of the one notification for several emails that arrived at once in a profile, which opens its inbox when clicked
#: src/main/notifications.ts
msgid "{count, plural, one {# new message} other {# new messages}}"
msgstr "{count, plural, one {# new message} other {# new messages}}"

#. Read out by a screen reader for the unread badge on Meru's taskbar button on Windows
#: src/main/badge.ts
msgid "{count, plural, one {# unread message} other {# unread messages}}"
msgstr "{count, plural, one {# unread message} other {# unread messages}}"

#. How much of a running download has arrived, in the Downloads card, such as 12.4 of 48 MB; done is a number, total a size with its unit
#: src/shell/downloads.tsx
msgid "{done} of {total}"
msgstr "{done} of {total}"

#. Item in the Do Not Disturb menu that holds notifications for this many hours
#: src/main/commands.ts
msgid "{hours, plural, one {For # Hour} other {For # Hours}}"
msgstr "{hours, plural, one {For # Hour} other {For # Hours}}"

#. Tooltip of a control that has a keyboard shortcut: {label} is what the control does, {shortcut} its keys as the platform writes them, such as ⌘R or Ctrl+R
#: src/shell/shortcut-title.ts
msgid "{label} ({shortcut})"
msgstr "{label} ({shortcut})"

#. Shown on an unread badge when more messages are unread than the number before the plus
#. Shown on an unread badge, on a profile's tab in the title bar or on Gmail's tab, when more messages are unread than the number before the plus
#: src/main/badge.ts
#: src/shell/unread-badge.tsx
msgid "{MAX_SHOWN_UNREAD}+"
msgstr "{MAX_SHOWN_UNREAD}+"

#. Item in the Do Not Disturb menu that holds notifications for this many minutes
#: src/main/commands.ts
msgid "{minutes, plural, one {For # Minute} other {For # Minutes}}"
msgstr "{minutes, plural, one {For # Minute} other {For # Minutes}}"

#. Tooltip of a profile's button in the title bar while the profile sleeps: its pages are closed, its mail still checked; {name} is the profile's name
#: src/shell/titlebar.tsx
msgid "{name} · asleep"
msgstr "{name} · asleep"

#. Tooltip of a profile's button in the title bar while the profile sleeps and its Google account is signed out; {name} is the profile's name
#: src/shell/titlebar.tsx
msgid "{name} · asleep · sign in required"
msgstr "{name} · asleep · sign in required"

#. A profile in the tray's menu with its unread count; {name} is the profile's name and {count} the number of unread messages
#: src/main/tray.ts
msgid "{name} ({count})"
msgstr "{name} ({count})"

#. Heading shown in place of a tab's page that could not load; {name} is the app, such as Gmail or Calendar
#: src/shell/tab-problem.tsx
msgid "{name} couldn’t load"
msgstr "{name} couldn’t load"

#. Second sentence after an action in the unified inbox failed because the profile's Google account is signed out; {name} is the profile
#: src/shell/inbox.tsx
msgid "{name} is signed out."
msgstr "{name} is signed out."

#. Explanation under the offline heading in place of a tab's page; {name} is the app, such as Gmail or Calendar
#: src/shell/tab-problem.tsx
msgid "{name} loads by itself when you’re back online."
msgstr "{name} loads by itself when you’re back online."

#. Heading shown in place of a tab's page that crashed; {name} is the app, such as Gmail or Calendar
#: src/shell/tab-problem.tsx
msgid "{name} stopped working"
msgstr "{name} stopped working"

#. Accessible name of a profile's button in the title bar, read by screen readers, while the profile sleeps: its pages are closed, its mail still checked; {name} is the profile's name
#: src/shell/titlebar.tsx
msgid "{name}, asleep"
msgstr "{name}, asleep"

#. Accessible name of a profile's button in the title bar, read by screen readers, while the profile sleeps and its Google account is signed out; {name} is the profile's name
#: src/shell/titlebar.tsx
msgid "{name}, asleep, sign in required"
msgstr "{name}, asleep, sign in required"

#. Accessible name and tooltip of a profile's button in the title bar while its Google account is signed out; {name} is the profile's name
#: src/shell/titlebar.tsx
msgid "{name}, sign in required"
msgstr "{name}, sign in required"

#. Description under Sign in required in the page area of a profile with no app open; {name} is the profile's name
#: src/shell/nothing-open.tsx
msgid "{name}'s Google account is signed out, so its mail is not checked."
msgstr "{name}'s Google account is signed out, so its mail is not checked."

#. The find bar's count: {ordinal} is the match shown, {matches} how many the page has, such as 2/14; 0/0 with none
#: src/shell/find-bar.tsx
msgid "{ordinal}/{matches}"
msgstr "{ordinal}/{matches}"

#. Title of the error dialog shown when the app's window keeps failing to draw and the app quits; {productName} is the app's name
#: src/main/shell-recovery.ts
msgid "{productName} could not draw its window"
msgstr "{productName} could not draw its window"

#. Title of the error dialog shown when the app fails to open; {productName} is the app's name
#: src/main/failures.ts
msgid "{productName} could not start"
msgstr "{productName} could not start"

#. Second line of a finished download in the Downloads card, such as 2.4 MB · 2 hours ago; {saved} is its size with its unit, {when} when it started, such as 2 hours ago or yesterday
#: src/shell/downloads.tsx
msgid "{saved} · {when}"
msgstr "{saved} · {when}"

#. Read by screen readers on the title bar's Downloads button while downloads run, such as 40% downloaded
#: src/shell/downloads.tsx
msgid "{share} downloaded"
msgstr "{share} downloaded"

#. Tooltip of a tile in the sidebar while its tab sleeps: put to sleep, or not opened yet since Meru started; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "{title} · asleep"
msgstr "{title} · asleep"

#. Tooltip of Gmail's tile in the sidebar while it sleeps and the profile's Google account is signed out; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "{title} · asleep · sign in required"
msgstr "{title} · asleep · sign in required"

#. Tooltip of a tile in the sidebar whose tab was moved to a window of its own; a click brings that window forward; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "{title} · in its own window"
msgstr "{title} · in its own window"

#. Tooltip of Gmail's tile in the sidebar while the profile's Google account is signed out; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "{title} · sign in required"
msgstr "{title} · sign in required"

#. Heading in place of the selected tab's page after it was put to sleep; {title} is the tab's title or else its app's name
#: src/shell/sleeping-tab.tsx
msgid "{title} is sleeping"
msgstr "{title} is sleeping"

#. Said by screen readers when a tab cannot move up with the keyboard, being first among the pinned tabs or the other tabs; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "{title}, already first"
msgstr "{title}, already first"

#. Said by screen readers when a tab cannot move down with the keyboard, being last among the pinned tabs or the other tabs; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "{title}, already last"
msgstr "{title}, already last"

#. Said by screen readers after a tab is moved with the keyboard; {title} is the tab's title, {position} its place among the pinned tabs or the other tabs, a split's box counting as one, and {count} how many places there are
#: src/shell/tab-strip.tsx
msgid "{title}, position {position} of {count}"
msgstr "{title}, position {position} of {count}"

#. Said by screen readers after the title of a tab in the sidebar's split view box; {told} is what is said of it otherwise, such as Asleep
#: src/shell/tab-strip.tsx
msgid "{told}, in split view"
msgstr "{told}, in split view"

#. Said by screen readers after the title of a tab in the sidebar's split view box while one pane shows alone; {told} is what is said of it otherwise, such as Asleep
#: src/shell/tab-strip.tsx
msgid "{told}, in split view, maximized"
msgstr "{told}, in split view, maximized"

#. Below the unified inbox when a profile has more unread mail than the list shows, since Gmail lists only the newest; {name} is the profile, {listed} how many are shown, # how many are unread
#: src/shell/inbox.tsx
msgid "{unreadCount, plural, one {{name}: the newest {listed} of # unread} other {{name}: the newest {listed} of # unread}}"
msgstr "{unreadCount, plural, one {{name}: the newest {listed} of # unread} other {{name}: the newest {listed} of # unread}}"

#. Second line of a download in the Downloads card that was interrupted, such as Failed · 2 hours ago, Failed in the destructive colour; {when} is when it started, such as 2 hours ago or yesterday
#: src/shell/downloads.tsx
msgid "<0>Failed</0> · {when}"
msgstr "<0>Failed</0> · {when}"

#. Read by screen readers on the title bar's Downloads button, green once a download finished and the list has not been opened since
#: src/shell/downloads.tsx
msgid "A download finished"
msgstr "A download finished"

#. Menu item in the macOS app menu that shows the app's version; {appName} is the app's name
#: src/main/application-menu.ts
msgid "About {appName}"
msgstr "About {appName}"

#. Menu item in the View menu that sets the page's zoom back to 100%
#: src/main/application-menu.ts
msgid "Actual Size"
msgstr "Actual Size"

#. Menu item in the Window menu that adds a profile, signed in to no account yet, and selects it
#: src/main/commands.ts
msgid "Add Profile"
msgstr "Add Profile"

#. Label over the band along the window's edge that lights up while a tab is dragged near it; dropping it puts the tab there beside every pane
#: src/shell/drop-zone.tsx
msgid "Along the whole view"
msgstr "Along the whole view"

#. Heading of the group of Google's apps in the New tab launcher
#: src/shell/open-app.tsx
msgid "Apps"
msgstr "Apps"

#. Accessible name of the list under the New tab launcher's search field, read by screen readers
#: src/shell/open-app.tsx
msgid "Apps and bookmarks"
msgstr "Apps and bookmarks"

#. Button on a new email notification that archives the email. Gmail's own word for the action
#: src/main/notifications.ts
msgid "Archive"
msgstr "Archive"

#. Button on a message in the unified inbox that archives it. Gmail's own word for the action
#: src/shell/inbox.tsx
msgctxt "inbox action"
msgid "Archive"
msgstr "Archive"

#. Said by screen readers after a sidebar row's title while its tab sleeps: put to sleep, or not opened yet since Meru started
#: src/shell/tab-strip.tsx
msgid "Asleep"
msgstr "Asleep"

#. Accessible name and tooltip of the title bar button that goes to the page the tab showed before
#. Menu item in the View menu that goes to the page the selected tab showed before
#: src/main/commands.ts
#: src/shell/titlebar.tsx
msgid "Back"
msgstr "Back"

#. Under the Open in split heading: the app picked opens in a new pane under the focused one
#: src/shell/open-app.tsx
msgid "Below the focused pane"
msgstr "Below the focused pane"

#. Under the Open in split heading: the app picked opens in a new pane to the right of the focused one
#: src/shell/open-app.tsx
msgid "Beside the focused pane"
msgstr "Beside the focused pane"

#. Accessible name of the bookmark button on a tab's row, which saves its page as a bookmark; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "Bookmark {title}"
msgstr "Bookmark {title}"

#. Short notice at the foot of the window once the selected tab's page is no longer bookmarked
#: src/shell/toast.tsx
msgid "Bookmark removed"
msgstr "Bookmark removed"

#. Tooltip of the bookmark button on a tab's row in the wide sidebar, which saves its page as a bookmark
#: src/shell/tab-strip.tsx
msgid "Bookmark tab"
msgstr "Bookmark tab"

#. Accessible name and tooltip of the bookmark button in the title bar of a tab's own window, which saves its page as a bookmark
#: src/shell/bookmarks.tsx
msgctxt "button"
msgid "Bookmark tab"
msgstr "Bookmark tab"

#. Menu item, in the Tabs menu and a tab's context menu, that saves the tab's page as a bookmark of its profile
#: src/main/menu-labels.ts
msgid "Bookmark Tab"
msgstr "Bookmark Tab"

#. Short notice at the foot of the window once the selected tab's page is bookmarked; {page} is the page's title
#: src/shell/toast.tsx
msgid "Bookmarked {page}"
msgstr "Bookmarked {page}"

#. Heading of the group of the profile's bookmarks in the New tab launcher
#: src/shell/open-app.tsx
msgid "Bookmarks"
msgstr "Bookmarks"

#. Menu item in the macOS Window menu
#: src/main/application-menu.ts
msgid "Bring All to Front"
msgstr "Bring All to Front"

#. Button in the dialog that confirms removing a profile, which keeps it
#: src/main/profile-copy.ts
msgid "Cancel"
msgstr "Cancel"

#. Button on a running download in the Downloads card that stops it; it shows a spinner until pointed at
#: src/shell/downloads.tsx
msgid "Cancel download"
msgstr "Cancel download"

#. Second line of a download in the Downloads card that was cancelled, such as Cancelled · 2 hours ago; {when} is when it started, such as 2 hours ago or yesterday
#: src/shell/downloads.tsx
msgid "Cancelled · {when}"
msgstr "Cancelled · {when}"

#. Button in the Downloads card's header that takes every download off the list but those still running
#: src/shell/downloads.tsx
msgid "Clear all"
msgstr "Clear all"

#. Button in the find bar that ends the search and hides the bar
#. Menu item in the Window menu that closes the window
#: src/main/application-menu.ts
#: src/shell/find-bar.tsx
msgid "Close"
msgstr "Close"

#. Accessible name of the cross on a tab that closes it; {title} is the tab's title
#: src/shell/tab-strip.tsx
msgid "Close {title}"
msgstr "Close {title}"

#. Item of a tab's context menu that closes every other tab of the profile but pinned ones
#: src/main/tab-menu.ts
msgid "Close Other Tabs"
msgstr "Close Other Tabs"

#. Menu item, in the Tabs menu and a tab's context menu, that closes the tab
#: src/main/menu-labels.ts
msgid "Close Tab"
msgstr "Close Tab"

#. Item of a tab's context menu that closes the tabs below it in the sidebar but pinned ones
#: src/main/tab-menu.ts
msgid "Close Tabs Below"
msgstr "Close Tabs Below"

#. Menu item in the macOS Window menu
#: src/main/application-menu.ts
msgid "Close Window"
msgstr "Close Window"

#. Accessible name and tooltip of the button at the foot of the wide list of tabs that collapses it to a narrow column of icons alone
#: src/shell/tab-strip.tsx
msgid "Collapse sidebar"
msgstr "Collapse sidebar"

#. Menu item in the Mail menu that opens a new message in the selected profile's Gmail
#: src/main/commands.ts
msgid "Compose"
msgstr "Compose"

#. Accessible name of the window's main area, below the title bar, read by screen readers
#: src/shell/app.tsx
msgid "Content"
msgstr "Content"

#. Text of the notification for an email that carries a one-time code, already copied to the clipboard. {verificationCode} is the code's digits, such as 482910
#: src/main/notifications.ts
msgid "Copied verification code {verificationCode}"
msgstr "Copied verification code {verificationCode}"

#. Button on a notification that copies the verification code
#. Menu item in the Edit menu
#: src/main/application-menu.ts
#: src/main/notifications.ts
msgid "Copy"
msgstr "Copy"

#. Item of a tab's context menu that copies its page's address
#: src/main/tab-menu.ts
msgid "Copy URL"
msgstr "Copy URL"

#. Said in the unified inbox when archiving a message failed and the message was put back in the list
#: src/shell/inbox.tsx
msgid "Couldn’t archive the message."
msgstr "Couldn’t archive the message."

#. Said by screen readers after a tab's title when its page could not load
#: src/shell/tab-strip.tsx
msgid "Couldn’t load"
msgstr "Couldn’t load"

#. Said in the unified inbox when marking a message read failed and the message was put back in the list
#: src/shell/inbox.tsx
msgid "Couldn’t mark the message as read."
msgstr "Couldn’t mark the message as read."

#. Said in the unified inbox when deleting a message failed and the message was put back in the list
#: src/shell/inbox.tsx
msgid "Couldn’t move the message to Trash."
msgstr "Couldn’t move the message to Trash."

#. Said in the unified inbox when reporting a message as spam failed and the message was put back in the list
#: src/shell/inbox.tsx
msgid "Couldn’t report the message as spam."
msgstr "Couldn’t report the message as spam."

#. Menu item in the Edit menu
#: src/main/application-menu.ts
msgid "Cut"
msgstr "Cut"

#. Name of the first profile until the person renames it, shown in the title bar
#: src/main/profile-copy.ts
msgctxt "profile name"
msgid "Default"
msgstr "Default"

#. Button on a new email notification that moves the email to Gmail's Trash. Gmail's own word for the action
#. Menu item in the Edit menu that deletes the selected text
#: src/main/application-menu.ts
#: src/main/notifications.ts
msgid "Delete"
msgstr "Delete"

#. Button on a message in the unified inbox that moves it to Trash. Gmail's own word for the action
#: src/shell/inbox.tsx
msgctxt "inbox action"
msgid "Delete"
msgstr "Delete"

#. Accessible name of the moon button in the title bar that holds new mail notifications, read by screen readers with whether it is pressed
#. Command that turns Do Not Disturb on until turned off, or off, checked while it holds new mail notifications
#. Submenu of the app menu with how long to hold new mail notifications for, or to stop
#: src/main/application-menu.ts
#: src/main/commands.ts
#: src/shell/titlebar.tsx
msgid "Do Not Disturb"
msgstr "Do Not Disturb"

#. Tooltip of the moon button in the title bar while new mail notifications show; a click turns Do Not Disturb on
#: src/shell/titlebar.tsx
msgid "Do Not Disturb is off"
msgstr "Do Not Disturb is off"

#. Tooltip of the moon button in the title bar while it holds new mail notifications; {time} is the time of day it ends, such as 14:30
#: src/shell/titlebar.tsx
msgid "Do Not Disturb is on until {time}"
msgstr "Do Not Disturb is on until {time}"

#. Tooltip of the moon button in the title bar while it holds new mail notifications until the person turns it off
#: src/shell/titlebar.tsx
msgid "Do Not Disturb is on until turned off"
msgstr "Do Not Disturb is on until turned off"

#. Title of the system notification when a download stops before it is done; the file's name is its text
#: src/main/download-notifications.ts
msgid "Download failed"
msgstr "Download failed"

#. Title of the system notification when a download is done; {fileName} is the file's name
#: src/main/download-notifications.ts
msgid "Downloaded {fileName}"
msgstr "Downloaded {fileName}"

#. Accessible name of the Downloads card's list, read by screen readers
#: src/shell/downloads.tsx
msgid "Downloaded files"
msgstr "Downloaded files"

#. Read by screen readers on the title bar's Downloads button while a download whose size is not known runs
#: src/shell/downloads.tsx
msgid "Downloading"
msgstr "Downloading"

#. Accessible name and tooltip of the Downloads button in the title bar, pressed while the list of downloaded files shows
#. Menu item in the View menu, checked while the list of downloaded files is open over the page
#. Title of the overlay over the page that lists the files downloaded in every profile
#: src/main/commands.ts
#: src/shell/downloads.tsx
msgid "Downloads"
msgstr "Downloads"

#. Item of a tab's context menu that opens another tab of the same app at the same page
#: src/main/tab-menu.ts
msgid "Duplicate"
msgstr "Duplicate"

#. Name of the Edit menu
#: src/main/application-menu.ts
msgid "Edit"
msgstr "Edit"

#. Tray menu item that quits Meru
#: src/main/tray.ts
msgctxt "Windows"
msgid "Exit"
msgstr "Exit"

#. Accessible name and tooltip of the button at the foot of the narrow list of tabs that expands it to a wide list showing each tab's title
#: src/shell/tab-strip.tsx
msgid "Expand sidebar"
msgstr "Expand sidebar"

#. Shown in the Downloads card when nothing is listed
#: src/shell/downloads.tsx
msgid "Files you download appear here for 30 days."
msgstr "Files you download appear here for 30 days."

#. Name and placeholder of the field in the small bar over the page that searches the page's text
#: src/shell/find-bar.tsx
msgid "Find in page"
msgstr "Find in page"

#. Menu item in the Edit menu that goes to the next match of the text searched for in the page
#: src/main/commands.ts
msgid "Find Next"
msgstr "Find Next"

#. Menu item in the Edit menu that goes to the previous match of the text searched for in the page
#: src/main/commands.ts
msgid "Find Previous"
msgstr "Find Previous"

#. Menu item in the Edit menu that opens a small bar over the page to search its text
#: src/main/commands.ts
msgid "Find…"
msgstr "Find…"

#. Accessible name and tooltip of the title bar button that goes to the page the tab left by going back
#. Menu item in the View menu that goes to the page the selected tab left by going back
#: src/main/commands.ts
#: src/shell/titlebar.tsx
msgid "Forward"
msgstr "Forward"

#. Menu item in the Mail menu that opens Gmail's own settings in the selected profile's Gmail tab
#: src/main/commands.ts
msgid "Gmail Settings"
msgstr "Gmail Settings"

#. Name of the Help menu
#: src/main/application-menu.ts
msgid "Help"
msgstr "Help"

#. Menu item in the macOS app menu that hides the app; {appName} is the app's name
#: src/main/application-menu.ts
msgid "Hide {appName}"
msgstr "Hide {appName}"

#. Tray menu item that hides Meru's window; {productName} is Meru
#: src/main/tray.ts
msgid "Hide {productName}"
msgstr "Hide {productName}"

#. Menu item in the macOS app menu that hides every other app
#: src/main/application-menu.ts
msgid "Hide Others"
msgstr "Hide Others"

#. Tooltip of the title bar button that hides the list of tabs down the left of the window
#: src/shell/titlebar.tsx
msgid "Hide sidebar"
msgstr "Hide sidebar"

#. Said by screen readers after a sidebar row's title while its tab is moved to a window of its own, which a click brings forward
#: src/shell/tab-strip.tsx
msgid "In its own window"
msgstr "In its own window"

#. Said by screen readers after the title of a tab in the sidebar's split view box, whose page is one of the panes shown side by side
#: src/shell/tab-strip.tsx
msgid "In split view"
msgstr "In split view"

#. Said by screen readers after the title of a tab in the sidebar's split view box while the focused pane shows alone, the others hidden until restored
#: src/shell/tab-strip.tsx
msgid "In split view, maximized"
msgstr "In split view, maximized"

#. Second sentence after an action in the unified inbox failed: the message shows in the list again
#: src/shell/inbox.tsx
msgid "It’s back in the list."
msgstr "It’s back in the list."

#. Explanation under the heading in place of a tab's page that crashed
#: src/shell/tab-problem.tsx
msgid "Its page quit unexpectedly. Reload it to carry on."
msgstr "Its page quit unexpectedly. Reload it to carry on."

#. Under the Downloads title: how long a downloaded file stays in the list below
#: src/shell/downloads.tsx
msgid "Kept for 30 days"
msgstr "Kept for 30 days"

#. Said by screen readers of the gap between two panes side by side: how much of the two the left one takes; {percent} is a percentage, such as 60%
#: src/shell/pane-handle.tsx
msgid "Left pane {percent}"
msgstr "Left pane {percent}"

#. Said by screen readers after a tab's title while its page loads
#: src/shell/tab-strip.tsx
msgid "Loading"
msgstr "Loading"

#. Name of the menu of commands on the selected profile's Gmail: compose, saved searches and Gmail's settings
#: src/main/application-menu.ts
msgid "Mail"
msgstr "Mail"

#. Button on a message in the unified inbox that marks it read. Gmail's own words for the action
#: src/shell/inbox.tsx
msgctxt "inbox action"
msgid "Mark as read"
msgstr "Mark as read"

#. Button on a new email notification that marks the email read. Gmail's own words for the action
#: src/main/notifications.ts
msgid "Mark as Read"
msgstr "Mark as Read"

#. Button on a new email notification that reports the email as spam. Gmail's own words for the action
#: src/main/notifications.ts
msgid "Mark as Spam"
msgstr "Mark as Spam"

#. Menu item, in the Tabs menu and a tab's context menu in a split view, that shows the pane alone, keeping the split
#: src/main/menu-labels.ts
msgid "Maximize Pane"
msgstr "Maximize Pane"

#. Label of the button in the wide sidebar's box of a split view while one pane shows alone; a click shows every pane again
#: src/shell/tab-strip.tsx
msgid "Maximized · Restore"
msgstr "Maximized · Restore"

#. Explanation under the heading in place of a tab's page that could not load
#: src/shell/tab-problem.tsx
msgid "Meru keeps trying by itself."
msgstr "Meru keeps trying by itself."

#. Explanation in the dialog that confirms removing a profile
#: src/main/profile-copy.ts
msgid "Meru signs out of this profile and deletes its data on this device. Your Google account isn't affected."
msgstr "Meru signs out of this profile and deletes its data on this device. Your Google account isn't affected."

#. Menu item in the Window menu
#: src/main/application-menu.ts
msgid "Minimize"
msgstr "Minimize"

#. Accessible name and tooltip of the button at the right of a tab's own window's title bar that opens a menu: Move to main window, Copy URL and the like
#: src/shell/own-window.tsx
msgid "More options"
msgstr "More options"

#. Menu item, in the Tabs menu, a tab's context menu and More options of a tab's own window, that puts its page back in the main window and closes that window
#: src/main/menu-labels.ts
msgid "Move to Main Window"
msgstr "Move to Main Window"

#. Menu item, in the Tabs menu and a tab's context menu, that moves the tab's page into a window of its own, the tab staying in the sidebar
#: src/main/menu-labels.ts
msgid "Move to New Window"
