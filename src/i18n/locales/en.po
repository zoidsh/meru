msgstr "Change where downloads are saved"

#. Button beside the license key on the Meru Pro page of Settings that opens a dialog to enter another key
#. Button in Settings beside the downloads folder that opens the system's folder picker
#: src/settings/general-page.tsx
#: src/settings/pro-page.tsx
msgid "Change…"
msgstr "Change…"

#. Line under the Settings scope switcher while one profile's scope is chosen; {chosenName} is the profile's name
#: src/settings/scope-tabs.tsx
msgid "Changes here only apply to {chosenName}."
msgstr "Changes here only apply to {chosenName}."

#. Description of the Language menu in Settings; Gmail's language is set in the person's Google account, not in Meru
#: src/settings/language-group.tsx
msgid "Changes the language Meru uses. Gmail uses the one set in your Google account."
msgstr "Changes the language Meru uses. Gmail uses the one set in your Google account."

#. On the About page of Settings before Meru has checked for a new version
#: src/settings/updates-group.tsx
msgid "Check for updates"
msgstr "Check for updates"

#. Label of the switch on the About page of Settings that has Meru check for new versions by itself
#: src/settings/updates-group.tsx
msgid "Check for updates automatically"
msgstr "Check for updates automatically"

#. Label of the switch on a profile's page in Settings that turns checking its mail on or off
#: src/settings/profile-page.tsx
msgid "Check mail"
msgstr "Check mail"

#. Button on the About page of Settings that checks for a new version of Meru at once
#: src/settings/updates-group.tsx
