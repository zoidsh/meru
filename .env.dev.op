# The development app's license key and a device id the licensing API answers
# with a trial: `op run --env-file .env.dev.op -- bun run dev`. Never around a
# build, which inlines `MERU_DEV_DEVICE_ID`, or the end-to-end suite, whose
# apps would all launch licensed.
MERU_LICENSE_KEY="op://dev/meru-test-license/license key"
MERU_DEV_DEVICE_ID="op://dev/meru-test-license/device id"
