# Imported where a value comes from the vault. With no service-account token,
# `op` signs in through the 1Password app instead; the optional file in the home
# directory supplies a token on a machine without it.
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=true, useCliWithServiceAccount=true)
# @import(~/.env.1password, allowMissing=true)
# ---
# @type=opServiceAccountToken @internal @optional
OP_TOKEN=
