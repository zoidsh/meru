  "banned": [
    {
      "id": "lowercase-ci",
      "pattern": "(?<!\\p{L})ci(?!\\p{L})",
      "severity": "doubtful",
      "reason": "The short dative for the user is capitalized, Ci, as every form of the pronoun is. Lower-case ci is also the plural these (ci użytkownicy), so a match asks rather than fails."
    },
    {
      "id": "uaktualnienie",
      "pattern": "[Uu]aktualni",
      "severity": "wrong",
      "reason": "An update is an aktualizacja, as Chrome writes it (Chrome: 321 messages, none with uaktualnienie); uaktualnienie is Apple's word, for a macOS label only.",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "pasek-tytulowy",
      "pattern": "[Pp]as\\p{L}* tytułow",
      "severity": "wrong",
      "reason": "The titlebar is the pasek tytułu, as Chrome writes it, never pasek tytułowy (Chrome: 5 messages, none the other way)."
    },
    {
      "id": "lacze",
      "pattern": "(?<!\\p{L})[Łł]ącz(?:e|em|u|a)(?!\\p{L})",
      "severity": "wrong",
      "reason": "A link is a link, as Chrome writes it, never Apple's łącze (Chrome: 161 messages, none the other way)."
    },
    {
      "id": "restart",
      "pattern": "(?<!\\p{L})[Zz]?[Rr]estart\\p{L}*",
      "severity": "wrong",
      "reason": "Restarting is uruchomić ponownie, as Chrome writes it: Uruchom ponownie (Chrome: 140 messages, 2 the other way)."
    },
    {
      "id": "katalog",
      "pattern": "(?<!\\p{L})[Kk]atalog\\p{L}*",
      "severity": "wrong",
      "reason": "A folder is a folder, as Chrome writes it, never katalog (Chrome: 78 messages, none the other way)."
    },
    {
      "id": "lowercase-pronoun",
      "pattern": "(?<!\\p{L})(?:twój|twoja|twoje|twojego|twojej|twojemu|twoim|twoją|twoich|twoimi|ciebie|cię|tobie|tobą)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Every form of the pronoun for the user is capitalized: Twój, Ciebie, Cię, Tobie (Chrome: 935 messages, none in lower case)."
    },
    {
      "id": "formal-address",
      "pattern": "(?<!\\p{L})(?:Pan|Pani|Panu|Panią|Pana|Państwo|Państwa|Państwu|Państwem)(?!\\p{L})",
      "severity": "wrong",
      "reason": "The user is addressed informally, never as Pan, Pani or Państwo."
    },
    {
      "id": "quotes",
      "pattern": "[\"“]",
      "severity": "wrong",
      "reason": "Quotation marks are „…” (U+201E, U+201D), as Chrome writes them (Chrome: 327 messages, 9 with straight quotes)."
    },
    {
      "id": "one-letter-word",
      "pattern": "(?<![\\p{L}\\p{N}])[wiozauWIOZAU] (?=[\\p{L}\\p{N}{])",
      "severity": "wrong",
      "reason": "A one-letter word is joined to the next by a no-break space (U+00A0), as Chrome and Apple write it: w Gmailu (Chrome: 4,295 messages, 705 with a plain space)."
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}]) (?=(?:sekund\\p{L}*|minut\\p{L}*|godzin\\p{L}*|dni|dzień|dnia|tygodni\\p{L}*|tydzień|miesi\\p{L}*|lat|lata|rok\\p{L}*|[kKMGT]B)(?!\\p{L}))",
      "severity": "wrong",
      "reason": "A number and its unit are joined by a no-break space (U+00A0), as Chrome writes them: 5 minut, # dni (Chrome: 86 messages, 24 with a plain space)."
    },
    {
      "id": "three-dots",
      "pattern": "\\.\\.\\.",
      "severity": "wrong",
      "reason": "An ellipsis is one character, …, never three full stops."
    },
    {
      "id": "ellipsis-space",
      "pattern": "[ \\u00a0]…",
      "severity": "wrong",
      "reason": "An ellipsis follows the word without a space: Ustawienia…"
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Nn]iestety|[Pp]rzepraszamy)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Niestety or Przepraszamy."
    }
  ],
