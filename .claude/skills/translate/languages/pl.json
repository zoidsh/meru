  "banned": [
    {
      "id": "lowercase-ci",
      "pattern": "(?<!\\p{L})ci(?!\\p{L})",
      "severity": "doubtful",
      "reason": "The short dative for the user is capitalized, Ci, as every form of the pronoun is. Lower-case ci is also the plural these (ci użytkownicy), so a match asks rather than fails."
    },
    {
      "id": "uaktualnienie",
      "pattern": "[Uu]aktualni",
      "severity": "wrong",
      "reason": "An update is an aktualizacja, as Chrome writes it; uaktualnienie is Apple's word, for a macOS label only (Chrome writes the banned form in 2 messages).",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "pasek-tytulowy",
      "pattern": "[Pp]as\\p{L}* tytułow",
      "severity": "wrong",
      "reason": "The titlebar is the pasek tytułu, as Chrome writes it, never pasek tytułowy (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "lacze",
      "pattern": "(?<!\\p{L})[Łł]ącz(?:e|em|u|a)(?!\\p{L})",
      "severity": "wrong",
      "reason": "A link is a link, as Chrome writes it, never Apple's łącze (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "restart",
      "pattern": "(?<!\\p{L})[Zz]?[Rr]estart\\p{L}*",
      "severity": "wrong",
      "reason": "Restarting is uruchomić ponownie, as Chrome writes it: Uruchom ponownie (Chrome writes the banned form in 4 messages)."
    },
    {
      "id": "katalog",
      "pattern": "(?<!\\p{L})[Kk]atalog\\p{L}*",
      "severity": "wrong",
      "reason": "A folder is a folder, as Chrome writes it, never katalog (Chrome writes the banned form in 15 messages)."
    },
    {
      "id": "lowercase-pronoun",
      "pattern": "(?<!\\p{L})(?:twój|twoja|twoje|twojego|twojej|twojemu|twoim|twoją|twoich|twoimi|ciebie|cię|tobie|tobą)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Every form of the pronoun for the user is capitalized: Twój, Ciebie, Cię, Tobie (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "formal-address",
      "pattern": "(?<!\\p{L})(?:Pan|Pani|Panu|Panią|Pana|Panów|Państwo|Państwa|Państwu|Państwem)(?!\\p{L})",
      "severity": "wrong",
      "reason": "The user is addressed informally, never as Pan, Pani or Państwo."
    },
    {
      "id": "quotes",
      "pattern": "[\"“]",
      "severity": "wrong",
      "reason": "Quotation marks are „…” (U+201E, U+201D), as Chrome writes them (Chrome writes the banned form in 9 messages)."
    },
    {
      "id": "one-letter-word",
      "pattern": "(?<![\\p{L}\\p{N}])[wiozauWIOZAU] (?=[\\p{L}\\p{N}{])",
      "severity": "wrong",
      "reason": "A one-letter word is joined to the next by a no-break space (U+00A0), as Chrome and Apple write it: w Gmailu (Chrome writes the banned form in 627 messages)."
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}]) (?=(?:sekund\\p{L}*|minut\\p{L}*|godzin\\p{L}*|dni|dzień|dnia|tygodni\\p{L}*|tydzień|miesi\\p{L}*|lat|lata|rok\\p{L}*|[kKMGT]B)(?!\\p{L}))",
      "severity": "wrong",
      "reason": "A number and its unit are joined by a no-break space (U+00A0), as Chrome writes them: 5 minut, # dni (Chrome writes the banned form in 27 messages)."
    },
    {
      "id": "three-dots",
      "pattern": "\\.\\.\\.",
      "severity": "wrong",
      "reason": "An ellipsis is one character, …, never three full stops."
    },
    {
      "id": "ellipsis-space",
      "pattern": "[ \\u00a0]…",
      "severity": "wrong",
      "reason": "An ellipsis follows the word without a space: Ustawienia…"
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Nn]iestety|[Pp]rzepraszamy)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Niestety or Przepraszamy."
    }
  ],
  "pinned": [
    {
      "id": "download-history",
      "msgidPattern": "\\bdownload history\\b",
      "expect": "[Hh]istori\\p{L}* pobierania",
      "severity": "wrong",
      "reason": "The download history is the historia pobierania (Chrome: 10 of 10 messages)."
    },
    {
