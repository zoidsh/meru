  "banned": [
    {
      "id": "tu",
      "pattern": "(?<!\\p{L})(?:[Tt]u|[Tt]eus?|[Tt]uas?|[Cc]ontigo|queres|tens|podes)(?!\\p{L})",
      "severity": "wrong",
      "reason": "The user is você, never tu or its verb forms (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "aba",
      "pattern": "(?<!\\p{L})[Aa]bas?(?!\\p{L})",
      "severity": "wrong",
      "reason": "A tab is a guia, as Chrome writes it: guia in 797 of 824 messages for tab, aba in 3 (Chrome writes the banned form in 3 messages)."
    },
    {
      "id": "european",
      "pattern": "(?<!\\p{L})(?:[Ff]icheiros?|[Ee]crãs?|[Uu]tilizador(?:es)?|[Tt]ransferi\\p{L}*)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Brazilian, not European: arquivo, tela, usuário, baixar (Chrome writes the banned form in 20 messages)."
    },
    {
      "id": "busca",
      "pattern": "(?<!\\p{L})[Bb]usca(?:r|s|da|do)?(?!\\p{L})",
      "severity": "wrong",
      "reason": "Searching is pesquisar and a search a pesquisa. Apple's Buscar Atualizações stays in a macOS label (Chrome writes the banned form in 26 messages).",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "email",
      "pattern": "(?<![\\p{L}{-])[Ee]mails?(?!\\p{L})",
      "severity": "wrong",
      "reason": "An email is an e-mail, with the hyphen. Microsoft's Novo Email stays in a Windows label (Chrome writes the banned form in none of its messages).",
      "allow": {
        "contexts": ["Windows"]
      }
    },
    {
      "id": "ajustes",
      "pattern": "(?<!\\p{L})[Aa]justes(?!\\p{L})",
      "severity": "wrong",
      "reason": "Settings is Configurações in Meru's own copy, as Chrome writes it. Ajustes is Apple's word, for a macOS label such as the app menu's Ajustes… and for macOS's own Ajustes do Sistema (Chrome writes the banned form in 3 messages).",
      "allow": {
        "contexts": ["macOS"],
        "msgidPattern": "\\bSystem Settings\\b"
      }
    },
    {
      "id": "quotes",
      "pattern": "[\"«»]",
      "severity": "wrong",
      "reason": "Quotation marks are “…” (U+201C, U+201D), as Apple writes them, never straight quotes or «»; Chrome's straight quotes (424 messages, against 20 with “”) are its own style (Chrome writes the banned form in 420 messages)."
    },
    {
      "id": "three-periods",
      "pattern": "\\.\\.\\.",
      "severity": "wrong",
      "reason": "An ellipsis is the one character …, as Apple writes it, never three periods; Chrome's three periods are its own style."
    },
    {
      "id": "ellipsis-space",
      "pattern": "[ \\u00a0\\u202f]…",
      "severity": "wrong",
      "reason": "The ellipsis follows the word with no space, as Apple writes it (and Chrome, which never spaces it)."
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}])[\\u00a0\\u202f](?=(?:segundos?|minutos?|horas?|dias?|semanas?|mês|meses|anos?|[kKMGT]B)(?!\\p{L}))",
      "severity": "wrong",
      "reason": "A number and its unit are parted by a plain space, as Chrome writes them: 5 minutos, # dias (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Dd]esculp\\p{L}*|[Pp]or favor|[Ii]nfelizmente|[Ll]amentamos)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Desculpe or Por favor."
    }
  ],
  "pinned": [
    {
      "id": "do-not-disturb",
      "msgidPattern": "\\bdo not disturb\\b",
      "expect": "Não Perturbe",
      "severity": "wrong",
      "reason": "Do Not Disturb is Apple's Não Perturbe, the name of macOS's Focus mode, in every language (DoNotDisturb.framework Localizable MODE_NAME_DEFAULT); Chrome's Não perturbe in prose is not followed."
    },
    {
      "id": "settings",
      "msgid": "Settings",
      "msgctxt": null,
      "expect": "^Configurações$",
      "severity": "wrong",
      "reason": "Settings is Configurações in Meru's own copy, as Chrome writes it (Chrome: 419 of 436 messages)."
    },
    {
      "id": "delete",
      "msgidPattern": "\\bdelet(?:e|es|ed)\\b",
      "expect": "[Ee]xclu",
      "severity": "wrong",
      "reason": "Deleting is excluir, as Chrome and Gmail write it (Chrome: 263 of 265 messages)."
    },
    {
      "id": "quit",
      "msgidPattern": "^Quit\\b",
      "msgctxt": null,
      "expect": "^Sai",
      "severity": "wrong",
      "reason": "Quitting is sair in Meru's own copy, such as the dialogs' Quit button; Chrome's encerrar is only its macOS app menu, where Quit {appName} is a macOS label and takes Apple's Encerrar (Chrome: 2 of 3 messages)."
    },
    {
      "id": "unpin",
      "msgid": "Unpin",
      "expect": "^Liberar",
      "severity": "wrong",
      "reason": "Unpinning is liberar (Chrome: 12 of 23 messages)."
    },
    {
      "id": "bookmark",
      "msgidPattern": "\\bbookmarks?\\b",
      "expect": "[Ff]avorito",
      "severity": "wrong",
      "reason": "A bookmark is a favorito (Chrome: 160 of 163 messages)."
    },
    {
      "id": "download-history",
      "msgidPattern": "\\bdownload history\\b",
      "expect": "[Hh]istórico de [Dd]ownloads",
      "severity": "wrong",
      "reason": "The download history is the histórico de downloads, also in Recent download history (Chrome: 8 of 10 messages)."
    },
    {
      "id": "extension",
      "msgidPattern": "\\bextensions?\\b",
      "expect": "[Ee]xtens[ãõ]",
      "severity": "wrong",
      "reason": "An extension is an extensão (Chrome: 302 of 307 messages)."
    },
    {
      "id": "close-other-tabs",
      "msgid": "Close Other Tabs",
      "expect": "^Fechar Outras Guias$",
      "severity": "wrong",
      "reason": "Close Other Tabs is Fechar Outras Guias, Chrome's tab menu item (both of its messages) in this sheet's title case."
    },
    {
      "id": "saved-search",
      "msgidPattern": "\\bsaved search(?:es)?\\b",
      "expect": "[Pp]esquisas? [Ss]alvas?",
      "severity": "wrong",
      "reason": "A saved search is a pesquisa salva (Chrome: 546 of 561 messages)."
    },
    {
      "id": "password-manager",
      "msgidPattern": "\\bpassword managers?\\b",
      "expect": "[Gg]erenciador(?:es)? de [Ss]enhas",
      "severity": "wrong",
      "reason": "A password manager is a gerenciador de senhas (Chrome: 77 of 77 messages)."
    },
    {
      "id": "passkey",
      "msgidPattern": "\\bpasskeys?\\b",
      "expect": "[Cc]haves? de [Aa]cesso",
      "severity": "wrong",
      "reason": "A passkey is a chave de acesso (Chrome: 93 of 106 messages)."
    },
    {
      "id": "default-browser",
      "msgidPattern": "\\bdefault browser\\b",
      "expect": "[Nn]avegador [Pp]adrão",
      "severity": "wrong",
      "reason": "The default browser is the navegador padrão (Chrome: 11 of 11 messages)."
    },
    {
