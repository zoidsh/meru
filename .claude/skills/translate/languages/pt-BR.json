  "banned": [
    {
      "id": "tu",
      "pattern": "(?<!\\p{L})(?:[Tt]u|[Tt]eus?|[Tt]uas?|[Cc]ontigo|queres|tens|podes)(?!\\p{L})",
      "severity": "wrong",
      "reason": "The user is você, never tu or its verb forms. Chrome: você in 2,641 of the 3,779 messages that address the user, tu in 2."
    },
    {
      "id": "aba",
      "pattern": "(?<!\\p{L})[Aa]bas?(?!\\p{L})",
      "severity": "wrong",
      "reason": "A tab is a guia, as Chrome writes it: guia in 797 of 824 messages for tab, aba in 3."
    },
    {
      "id": "european",
      "pattern": "(?<!\\p{L})(?:[Ff]icheiros?|[Ee]crãs?|[Uu]tilizador(?:es)?|[Tt]ransferi\\p{L}*)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Brazilian, not European: arquivo, tela, usuário, baixar. Chrome: arquivo in 519 of 530 messages for file, tela in 227 of 230 for screen, usuário in 52 of 57 for user, none with the European word."
    },
    {
      "id": "busca",
      "pattern": "(?<!\\p{L})[Bb]usca(?:r|s|da|do)?(?!\\p{L})",
      "severity": "doubtful",
      "reason": "Searching is pesquisar and a search a pesquisa. Chrome: pesquisar in 399 of 406 messages for search, buscar in 1. Apple's Buscar Atualizações stays in a macOS label.",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "email",
      "pattern": "(?<![\\p{L}{-])[Ee]mails?(?!\\p{L})",
      "severity": "doubtful",
      "reason": "An email is an e-mail, with the hyphen. Chrome: e-mail in 61 of 111 messages for email, email in none. Microsoft's Novo Email stays in a Windows label.",
      "allow": {
        "contexts": ["Windows"]
      }
    },
    {
      "id": "ajustes",
      "pattern": "(?<!\\p{L})[Aa]justes(?!\\p{L})",
      "severity": "wrong",
      "reason": "Settings is Configurações in Meru's own copy, as Chrome writes it (Chrome: 393 of 418 messages for settings, 14 with ajustes). Ajustes is Apple's word, for a macOS label such as the app menu's Ajustes… and for macOS's own Ajustes do Sistema.",
      "allow": {
        "contexts": ["macOS"],
        "msgidPattern": "\\bSystem Settings\\b"
      }
    },
    {
      "id": "quotes",
      "pattern": "[\"«»]",
      "severity": "wrong",
      "reason": "Quotation marks are “…” (U+201C, U+201D), as Apple writes them, never straight quotes or «»; Chrome's straight quotes (424 messages, against 20 with “”) are its own style."
    },
    {
      "id": "three-periods",
      "pattern": "\\.\\.\\.",
      "severity": "style",
      "reason": "An ellipsis is the one character …, as Apple writes it, never three periods; Chrome's three periods are its own style."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Dd]esculp\\p{L}*|[Pp]or favor|[Ii]nfelizmente|[Ll]amentamos)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Desculpe or Por favor."
    }
  ],
