  "banned": [
    {
      "id": "tu",
      "pattern": "(?<!\\p{L})(?:[Tt]u|[Tt]eus?|[Tt]uas?|[Cc]ontigo|queres|tens|podes)(?!\\p{L})",
      "severity": "wrong",
      "reason": "The user is você, never tu or its verb forms (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "aba",
      "pattern": "(?<!\\p{L})[Aa]bas?(?!\\p{L})",
      "severity": "wrong",
      "reason": "A tab is a guia, as Chrome writes it: guia in 797 of 824 messages for tab, aba in 3 (Chrome writes the banned form in 3 messages)."
    },
    {
      "id": "european",
      "pattern": "(?<!\\p{L})(?:[Ff]icheiros?|[Ee]crãs?|[Uu]tilizador(?:es)?|[Tt]ransferi\\p{L}*)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Brazilian, not European: arquivo, tela, usuário, baixar (Chrome writes the banned form in 20 messages)."
    },
    {
      "id": "busca",
      "pattern": "(?<!\\p{L})[Bb]usca(?:r|s|da|do)?(?!\\p{L})",
      "severity": "wrong",
      "reason": "Searching is pesquisar and a search a pesquisa. Apple's Buscar Atualizações stays in a macOS label (Chrome writes the banned form in 26 messages).",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "email",
      "pattern": "(?<![\\p{L}{-])[Ee]mails?(?!\\p{L})",
      "severity": "wrong",
      "reason": "An email is an e-mail, with the hyphen. Microsoft's Novo Email stays in a Windows label (Chrome writes the banned form in none of its messages).",
      "allow": {
        "contexts": ["Windows"]
      }
    },
    {
      "id": "ajustes",
      "pattern": "(?<!\\p{L})[Aa]justes(?!\\p{L})(?![ \\u00a0]do[ \\u00a0]Sistema(?!\\p{L}))",
      "severity": "wrong",
      "reason": "Settings is Configurações in Meru's own copy, as Chrome writes it. Ajustes is Apple's word in two places only: the macOS app menu's Ajustes… (AppKit MenuCommands Settings\\U2026) and macOS's own Ajustes do Sistema (TranslationAPIExtension.appex Localizable SYSTEM_SETTINGS) (Chrome writes the banned form in 3 messages).",
      "allow": {
        "entries": [{ "msgctxt": "macOS", "msgid": "Settings" }]
      }
    },
    {
      "id": "quotes",
      "pattern": "[\"«»]",
      "severity": "wrong",
      "reason": "Quotation marks are “…” (U+201C, U+201D), as Apple writes them, never straight quotes or «»; Chrome's straight quotes (424 messages, against 20 with “”) are its own style (Chrome writes the banned form in 420 messages)."
    },
    {
      "id": "three-periods",
      "pattern": "\\.\\.\\.",
      "severity": "wrong",
      "reason": "An ellipsis is the one character …, as Apple writes it, never three periods; Chrome's three periods are its own style."
    },
    {
      "id": "ellipsis-space",
      "pattern": "[ \\u00a0\\u202f]…",
      "severity": "wrong",
      "reason": "The ellipsis follows the word with no space, as Apple writes it (and Chrome, which never spaces it)."
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}])[\\u00a0\\u202f](?=(?:segundos?|minutos?|horas?|dias?|semanas?|mês|meses|anos?|[kKMGT]B)(?!\\p{L}))",
      "severity": "wrong",
      "reason": "A number and its unit are parted by a plain space, as Chrome writes them: 5 minutos, # dias (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Dd]esculp\\p{L}*|[Pp]or favor|[Ii]nfelizmente|[Ll]amentamos)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Desculpe or Por favor."
    }
  ],
