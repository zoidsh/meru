    },
    {
      "id": "password-manager",
      "msgidPattern": "\\bpassword managers?\\b",
      "expect": "[Ww]achtwoordmanager",
      "severity": "wrong",
      "reason": "A password manager is a wachtwoordmanager, as Chrome writes it (Chrome: 85 messages of 85)."
    },
    {
      "id": "passkey",
      "msgidPattern": "\\bpasskeys?\\b",
      "expect": "[Tt]oegangssleutel",
      "severity": "wrong",
      "reason": "A passkey is a toegangssleutel, as Chrome writes it (Chrome: 84 messages, 1 with passkey)."
    },
    {
      "id": "default-browser",
      "msgidPattern": "\\bdefault browser\\b",
      "expect": "[Ss]tandaardbrowser",
      "severity": "wrong",
      "reason": "The default browser is the standaardbrowser, as Chrome writes it (Chrome: 35 messages of 35)."
    },
    {
      "id": "update",
      "msgidPattern": "\\bupdat(?:e|es|ed|ing)\\b",
      "expect": "[Uu]pdat|üpdat",
      "severity": "wrong",
      "reason": "An update is an update, and updating is updaten, as Chrome writes them (Chrome: 327 messages, 3 with bijwerken)."
    },
    {
      "id": "restart",
      "msgidPattern": "\\brestart",
      "expect": "[Oo]pnieuw",
      "severity": "wrong",
      "reason": "Restarting is opnieuw starten, as Chrome writes it most: Start Meru opnieuw (Chrome: 73 messages, 26 with herstarten)."
    },
    {
      "id": "titlebar",
      "msgidPattern": "\\btitle ?bar\\b",
      "expect": "[Tt]itelbalk",
