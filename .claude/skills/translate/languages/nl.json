  "banned": [
    {
      "id": "bladwijzer",
      "pattern": "[Bb]ladwijzer",
      "severity": "wrong",
      "reason": "A bookmark is a bookmark, as Chrome writes it, never Apple's bladwijzer (Chrome writes the banned form in 2 messages)."
    },
    {
      "id": "notificatie",
      "pattern": "[Nn]otificatie",
      "severity": "wrong",
      "reason": "A notification is a melding, as Chrome and Apple write it, never notificatie (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "bewaren",
      "pattern": "(?<!\\p{L})(?:[Bb]ewaar\\p{L}*|[Bb]ewaard\\p{L}*)",
      "severity": "wrong",
      "reason": "Saving is opslaan, as Chrome writes it: Sla op, opgeslagen. Bewaar is Apple's word, for a macOS label only (Chrome writes the banned form in 14 messages).",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "vastmaken",
      "pattern": "(?<!\\p{L})(?:[Vv]astgemaakt\\p{L}*|[Vv]astmaken|[Mm]aak (?:\\p{L}+ )?vast)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Pinning is vastzetten, as Chrome writes it: Zet vast, vastgezet tabblad; vastmaken is Apple's word (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "bijwerken",
      "pattern": "[Bb]ijwerk|[Bb]ijgewerkt",
      "severity": "wrong",
      "reason": "Updating is updaten, with update for the noun, as Chrome writes it (Chrome writes the banned form in 7 messages)."
    },
    {
      "id": "u",
      "pattern": "(?<![\\p{L}\\p{N}+])(?:[Uu]|[Uu]w)(?![\\p{L}\\p{N}+])",
      "severity": "wrong",
      "reason": "The user is je, with jouw or je, never u or uw (Chrome writes the banned form in 8 messages)."
    },
    {
      "id": "quotes",
      "pattern": "[\"“”„]|(?<![\\p{L}\\p{N}])'(?=[\\p{L}\\p{N}{])[^'\\n]*'(?![\\p{L}\\p{N}])",
      "severity": "wrong",
      "reason": "Quotation marks are ‘…’ (U+2018, U+2019), never straight or double quotes."
    },
    {
      "id": "three-dots",
      "pattern": "\\.\\.\\.",
      "severity": "wrong",
      "reason": "An ellipsis is one character, …, never three full stops."
    },
    {
      "id": "ellipsis-space",
      "pattern": "[ \\u00a0]…",
      "severity": "wrong",
      "reason": "An ellipsis follows the word without a space: Instellingen…"
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}])[\\u00a0\\u202f](?=(?:seconden?|minuten?|minuut|uur|uren|dagen?|weken?|week|maanden?|maand|jaar|jaren|[kKMGT]B)(?!\\p{L}))",
      "severity": "wrong",
      "reason": "A number and its unit are parted by a plain space, as Chrome writes them: 5 minuten, # dagen (Chrome writes the banned form in 9 messages)."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Hh]elaas|[Ss]orry)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without helaas or sorry."
    }
  ],
