  "banned": [
    {
      "id": "bladwijzer",
      "pattern": "[Bb]ladwijzer",
      "severity": "wrong",
      "reason": "A bookmark is a bookmark, as Chrome writes it, never Apple's bladwijzer (Chrome: 195 messages, 2 the other way)."
    },
    {
      "id": "notificatie",
      "pattern": "[Nn]otificatie",
      "severity": "wrong",
      "reason": "A notification is a melding, as Chrome and Apple write it, never notificatie (Chrome: 126 messages, none the other way)."
    },
    {
      "id": "bewaren",
      "pattern": "(?<!\\p{L})(?:[Bb]ewaar\\p{L}*|[Bb]ewaard\\p{L}*)",
      "severity": "wrong",
      "reason": "Saving is opslaan, as Chrome writes it: Sla op, opgeslagen (Chrome: 553 messages, 9 the other way, all of them its own macOS menu labels). Bewaar is Apple's word, for a macOS label only.",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "vastmaken",
      "pattern": "(?<!\\p{L})(?:[Vv]astgemaakt\\p{L}*|[Vv]astmaken|[Mm]aak (?:\\p{L}+ )?vast)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Pinning is vastzetten, as Chrome writes it: Zet vast, vastgezet tabblad (Chrome: 68 messages, none the other way); vastmaken is Apple's word."
    },
    {
      "id": "bijwerken",
      "pattern": "[Bb]ijwerk|[Bb]ijgewerkt",
      "severity": "wrong",
      "reason": "Updating is updaten, with update for the noun, as Chrome writes it (Chrome: 327 messages, 3 the other way)."
    },
    {
      "id": "u",
      "pattern": "(?<![\\p{L}\\p{N}+])(?:[Uu]|[Uu]w)(?![\\p{L}\\p{N}+])",
      "severity": "wrong",
      "reason": "The user is je, with jouw or je, never u or uw (Chrome writes je in 3,646 messages, u or uw in 1)."
    },
    {
      "id": "quotes",
      "pattern": "[\"“”„]|(?<![\\p{L}\\p{N}])'(?=[\\p{L}\\p{N}{])[^'\\n]*'(?![\\p{L}\\p{N}])",
      "severity": "wrong",
      "reason": "Quotation marks are ‘…’ (U+2018, U+2019), never straight or double quotes."
    },
    {
      "id": "three-dots",
      "pattern": "\\.\\.\\.",
      "severity": "wrong",
      "reason": "An ellipsis is one character, …, never three full stops."
    },
    {
      "id": "ellipsis-space",
      "pattern": "[ \\u00a0]…",
      "severity": "wrong",
      "reason": "An ellipsis follows the word without a space: Instellingen…"
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}])[\\u00a0\\u202f](?=(?:seconden?|minuten?|minuut|uur|uren|dagen?|weken?|week|maanden?|maand|jaar|jaren|[kKMGT]B)(?!\\p{L}))",
      "severity": "wrong",
      "reason": "A number and its unit are parted by a plain space, as Chrome writes them: 5 minuten, # dagen (Chrome: 166 messages with a unit, 8 with a no-break space)."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Hh]elaas|[Ss]orry)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without helaas or sorry."
    }
  ],
  "pinned": [
    {
      "id": "download-history",
      "msgidPattern": "\\bdownload history\\b",
      "expect": "[Dd]ownloadgeschiedenis",
      "severity": "wrong",
      "reason": "The download history is downloadgeschiedenis, as Chrome writes it (glossary, Chrome: 10 messages of 10)."
    },
    {
      "id": "bookmark",
      "msgidPattern": "\\bbookmarks?\\b",
      "expect": "[Bb]ookmark",
      "severity": "wrong",
      "reason": "A bookmark is a bookmark, as Chrome writes it (glossary, Chrome: 195 messages of 197)."
    },
    {
      "id": "notification",
      "msgidPattern": "(?!Notifications$).*\\bnotifications?\\b",
      "expect": "[Mm]elding",
      "severity": "wrong",
      "reason": "A notification is a melding (glossary, Chrome: 126 messages of 126). The bare Notifications is also the toasts' region, under the toast rule."
    },
    {
      "id": "extension",
      "msgidPattern": "\\bextensions?\\b",
      "expect": "[Ee]xtensie",
      "severity": "wrong",
      "reason": "An extension is an extensie (glossary, Chrome: 394 messages of 400)."
    },
    {
      "id": "tab-strip",
      "msgidPattern": "\\btab strip\\b",
      "expect": "[Tt]abbladstrook",
      "severity": "wrong",
      "reason": "The tab strip is the tabbladstrook, as Chrome writes it (glossary, Chrome: 8 messages of 8)."
    },
    {
      "id": "do-not-disturb",
      "msgidPattern": "\\bdo not disturb\\b",
      "expect": "Niet storen",
      "severity": "wrong",
