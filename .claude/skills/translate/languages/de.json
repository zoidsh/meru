  "banned": [
    {
      "id": "mitteilung",
      "pattern": "[Mm]itteilung",
      "severity": "wrong",
      "reason": "A notification is Benachrichtigung in Meru's own copy; Mitteilung is Apple's word, for a macOS label only.",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "account",
      "pattern": "(?<![\\p{L}\\p{N}./@])Accounts?(?![\\p{L}\\p{N}])",
      "severity": "wrong",
      "reason": "An account is Konto, plural Konten, as in Google-Konto; never Account."
    },
    {
      "id": "sichern",
      "pattern": "(?<!\\p{L})(?:[Ss]ichern|[Ss]ichert|gesichert\\p{L}*|[Ss]ichere(?=\\s+\\p{Ll}))(?!\\p{L})",
      "severity": "wrong",
      "reason": "Keeping something is speichern; sichern is only Apple's word in a macOS label such as Sichern unter …",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "sie",
      "pattern": "(?<=[\\p{Ll},;:] )(?:Sie|Ihnen|Ihr|Ihre[mnrs]?)(?!\\p{L})",
      "severity": "wrong",
      "reason": "The user is du, never Sie, Ihr or Ihnen."
    },
    {
      "id": "ellipsis-space",
      "pattern": "(?<!\\u00a0)…",
      "severity": "wrong",
      "reason": "An ellipsis follows a no-break space (U+00A0): Einstellungen …"
    },
    {
      "id": "english-quotes",
      "pattern": "[\"”]",
      "severity": "wrong",
      "reason": "Quotation marks are „…“ (U+201E, U+201C)."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Ll]eider|Entschuldigung|[Bb]itte)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without leider, Entschuldigung or Bitte."
    }
  ],
  "pinned": [
    {
      "id": "download-history",
      "msgidPattern": "\\bdownload history\\b",
      "expect": "Downloadverlauf",
      "severity": "wrong",
      "reason": "The download history is Downloadverlauf (glossary)."
    },
    {
      "id": "upgrade",
      "msgidPattern": "\\bupgrade\\b",
      "expect": "[Uu]pgrade",
      "severity": "wrong",
      "reason": "Reaching Pro is an Upgrade, in buttons and prose alike, never a word for purchase (glossary)."
    },
    {
      "id": "gmail-label",
      "msgctxt": "Gmail label",
      "msgidPattern": "\\blabel\\b",
      "expect": "Label",
      "severity": "wrong",
      "reason": "A Gmail label is Gmail's Label (glossary)."
    }
  ],
  "accessKeys": {
    "style": "inline",
    "severity": "wrong",
    "reason": "A label whose English has an & keeps one & inline, before a letter of the German word; a macOS label drops it."
  },
