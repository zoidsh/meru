  "banned": [
    {
      "id": "mitteilung",
      "pattern": "[Mm]itteilung",
      "severity": "wrong",
      "reason": "A notification is Benachrichtigung in Meru's own copy; Mitteilung is Apple's word, for a macOS label only.",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "account",
      "pattern": "(?<![\\p{L}\\p{N}./@])Accounts?(?![\\p{L}\\p{N}])",
      "severity": "wrong",
      "reason": "An account is Konto, plural Konten, as Chrome writes it, as in Google-Konto; never Account (Chrome writes the banned form in 1 message)."
    },
    {
      "id": "sichern",
      "pattern": "(?<!\\p{L})(?:[Ss]ichern|[Ss]ichert|gesichert\\p{L}*|[Ss]ichere(?=\\s+\\p{Ll}))(?!\\p{L})",
      "severity": "wrong",
      "reason": "Keeping something is speichern; sichern is only Apple's word in a macOS label such as Sichern unter …",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "taste",
      "pattern": "(?<!(?:Control|Ctrl|Strg|Alt|Fn|Esc|Option|Cmd|Tab|Shift|Umschalt|Enter|Eingabe|Windows|Befehls)-)(?<!\\p{L})Tasten?(?!\\p{L})",
      "severity": "wrong",
      "reason": "An on-screen button is a Button; a standalone Taste reads as a keyboard key or a mouse button, as Chrome keeps it. Key names such as Umschalttaste are fine (Chrome writes the banned form in 81 messages).",
      "allow": {
        "msgidPattern": "\\bkeyboard\\b|(?<!license )\\bkeys?\\b"
      }
    },
    {
      "id": "schaltflaeche",
      "pattern": "[Ss]chaltfläche",
      "severity": "wrong",
      "reason": "An on-screen button is a Button, standalone and in a compound: Lesezeichen-Button, never Schaltfläche or a -schaltfläche compound (Chrome writes the banned form in 3 messages, all compounds such as Installationsschaltfläche, and compounds Button 12 times, such as Scroll-Buttons and Feedback-Button)."
    },
    {
      "id": "bewegen",
      "pattern": "(?<!\\p{L})[Bb]eweg(?:en|e|st|t|te|ten|ter|tes)?(?!\\p{L})",
      "severity": "doubtful",
      "reason": "Moving a file, tab or email is verschieben (glossary, agent-chosen); bewegen is only for dragging or the pointer.",
      "allow": {
        "msgidPattern": "\\b(?:mouse|pointer|cursor|drag\\w*)\\b"
      }
    },
    {
      "id": "ungelesen-kennzeichen",
      "pattern": "Ungelesen-(?:Kennzeichen|Badge)",
      "severity": "wrong",
      "reason": "The unread badge is the Kennzeichen für ungelesene E-Mails, never a coined Ungelesen-Kennzeichen or Ungelesen-Badge (glossary, agent-chosen)."
    },
    {
      "id": "sie",
      "pattern": "(?<=[\\p{Ll},;:] )(?:Sie|Ihnen|Ihr|Ihre[mnrs]?)(?!\\p{L})",
      "severity": "wrong",
      "reason": "The user is du, never Sie, Ihr or Ihnen."
    },
    {
      "id": "ellipsis-space",
      "pattern": "(?<!\\u00a0)…",
      "severity": "wrong",
      "reason": "An ellipsis follows a no-break space (U+00A0): Einstellungen …"
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}]) (?=(?:Sekunden?|Minuten?|Stunden?|Tag(?:e|en)?|Wochen?|Monat(?:e|en)?|Jahr(?:e|en)?|[kKMGT]B)(?!\\p{L}))",
      "severity": "wrong",
      "reason": "A number and its unit are joined by a no-break space (U+00A0), as Chrome writes them: 5 Minuten, # Tage (Chrome writes the banned form in 25 messages)."
    },
    {
      "id": "english-quotes",
      "pattern": "[\"”]",
      "severity": "wrong",
      "reason": "Quotation marks are „…“ (U+201E, U+201C)."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Ll]eider|Entschuldigung|[Bb]itte)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without leider, Entschuldigung or Bitte."
    }
  ],
