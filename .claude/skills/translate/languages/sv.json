  "banned": [
    {
      "id": "notis",
      "pattern": "(?<!\\p{L})[Nn]otis\\p{L}*",
      "severity": "wrong",
      "reason": "A notification is an avisering, as Chrome writes it, never Apple's notis (Chrome: 123 messages, none the other way); notis is for a macOS label only.",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "hamta",
      "pattern": "(?<!\\p{L})[Hh]ämt\\p{L}*",
      "severity": "wrong",
      "reason": "Downloading is ladda ned, a download a nedladdning, as Chrome writes them, never hämta or hämtning (Chrome: 269 messages, none the other way).",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "mejl",
      "pattern": "[Mm]ejl",
      "severity": "wrong",
      "reason": "An email is an e-postmeddelande, as Chrome writes it, never Apple's mejl (Chrome: 60 messages, none the other way); mejl is for a macOS label only.",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "gom",
      "pattern": "(?<!\\p{L})[Gg]öm(?:d|da|t|s|mer|ma|des)?(?!\\p{L})",
      "severity": "wrong",
      "reason": "Hiding is dölja, as Chrome writes it: Dölj (Chrome: 47 messages, none the other way); Göm is Apple's word, for a macOS label only.",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "nala",
      "pattern": "[Nn]åla",
      "severity": "wrong",
      "reason": "Pinning is fästa, as Chrome writes it: Fäst, fäst flik (Chrome: 100 messages, none with nåla fast)."
    },
    {
      "id": "ni",
      "pattern": "(?<![\\p{L}\\p{N}+])[Nn]i(?![\\p{L}\\p{N}+])",
      "severity": "wrong",
      "reason": "The user is du, never ni (Chrome writes du in 2,659 messages, ni in none)."
    },
    {
      "id": "quotes",
      "pattern": "[\"“„]",
      "severity": "wrong",
      "reason": "Quotation marks are ”…” (U+201D on both sides), as Chrome writes them."
    },
    {
      "id": "three-dots",
      "pattern": "\\.\\.\\.",
      "severity": "wrong",
      "reason": "An ellipsis is one character, …, never three full stops."
    },
    {
      "id": "ellipsis-space",
      "pattern": "[ \\u00a0]…",
      "severity": "wrong",
      "reason": "An ellipsis follows the word without a space: Inställningar…"
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}])[\\u00a0\\u202f](?=(?:sekunder?|minuter?|timmar?|timme|dagar?|dag|veckor?|vecka|månader?|månad|år|[kKMGT]B)(?!\\p{L}))",
      "severity": "wrong",
      "reason": "A number and its unit are parted by a plain space, as Chrome writes them: 5 minuter, # dagar (Chrome: 147 messages with a unit, 20 with a no-break space)."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Tt]yvärr|[Uu]rsäkta)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Tyvärr or Ursäkta."
    }
  ],
  "pinned": [
    {
      "id": "download-history",
      "msgidPattern": "\\bdownload history\\b",
      "expect": "[Nn]edladdningshistorik",
      "severity": "wrong",
      "reason": "The download history is the nedladdningshistorik, as Chrome writes it, never Apple's hämtningshistorik (glossary, Chrome: 10 messages of 10)."
    },
    {
      "id": "download",
      "msgidPattern": "\\bdownload",
      "expect": "[Nn]edladd|[Ll]add\\p{L}* ned",
      "severity": "wrong",
      "reason": "Downloading is ladda ned, a download a nedladdning, as Chrome writes them (Chrome: 269 messages of 282, none with hämta)."
    },
    {
      "id": "bookmark",
      "msgidPattern": "\\bbookmarks?\\b",
      "expect": "[Bb]okmärk",
      "severity": "wrong",
      "reason": "A bookmark is a bokmärke (glossary, Chrome: 197 messages of 197)."
    },
    {
      "id": "notification",
      "msgidPattern": "(?!Notifications$).*\\bnotifications?\\b",
      "expect": "[Aa]viser",
      "severity": "wrong",
      "reason": "A notification is an avisering, as Chrome writes it (glossary, Chrome: 123 messages of 126, none with notis). The bare Notifications is also the toasts' region, under the toast rule."
    },
    {
