  "banned": [
    {
      "id": "notis",
      "pattern": "(?<!\\p{L})[Nn]otis\\p{L}*",
      "severity": "wrong",
      "reason": "A notification is an avisering, as Chrome writes it, never Apple's notis; notis is for a macOS label only (Chrome writes the banned form in none of its messages).",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "hamta",
      "pattern": "(?<!\\p{L})[Hh]ämt\\p{L}*",
      "severity": "wrong",
      "reason": "Downloading is ladda ned, a download a nedladdning, as Chrome writes them, never hämta or hämtning. Fetching something that is not a download, such as a page or a code, can be hämta (Chrome writes the banned form in 32 messages).",
      "allow": {
        "contexts": ["macOS"],
        "msgidPattern": "^(?!.*\\bdownload)"
      }
    },
    {
      "id": "mejl",
      "pattern": "[Mm]ejl",
      "severity": "wrong",
      "reason": "An email is an e-postmeddelande, as Chrome writes it, never Apple's mejl; mejl is for a macOS label only (Chrome writes the banned form in none of its messages).",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "gom",
      "pattern": "(?<!\\p{L})[Gg]öm(?:d|da|t|s|mer|ma|des)?(?!\\p{L})",
      "severity": "wrong",
      "reason": "Hiding is dölja, as Chrome writes it: Dölj; Göm is Apple's word, for a macOS label only (Chrome writes the banned form in none of its messages).",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "nala",
      "pattern": "[Nn]åla",
      "severity": "wrong",
      "reason": "Pinning is fästa, as Chrome writes it: Fäst, fäst flik (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "ni",
      "pattern": "(?<![\\p{L}\\p{N}+])[Nn]i(?![\\p{L}\\p{N}+])",
      "severity": "wrong",
      "reason": "The user is du, never ni (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "quotes",
      "pattern": "[\"“„]",
      "severity": "wrong",
      "reason": "Quotation marks are ”…” (U+201D on both sides), as Chrome writes them."
    },
    {
      "id": "three-dots",
      "pattern": "\\.\\.\\.",
      "severity": "wrong",
      "reason": "An ellipsis is one character, …, never three full stops."
    },
    {
      "id": "ellipsis-space",
      "pattern": "[ \\u00a0]…",
      "severity": "wrong",
      "reason": "An ellipsis follows the word without a space: Inställningar…"
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}])[\\u00a0\\u202f](?=(?:sekunder?|minuter?|timmar?|timme|dagar?|dag|veckor?|vecka|månader?|månad|år|[kKMGT]B)(?!\\p{L}))",
      "severity": "wrong",
      "reason": "A number and its unit are parted by a plain space, as Chrome writes them: 5 minuter, # dagar (Chrome writes the banned form in 17 messages)."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Tt]yvärr|[Uu]rsäkta)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Tyvärr or Ursäkta."
    }
  ],
  "pinned": [
    {
      "id": "download-history",
      "msgidPattern": "\\bdownload history\\b",
      "expect": "[Nn]edladdningshistorik",
      "severity": "wrong",
      "reason": "The download history is the nedladdningshistorik, as Chrome writes it, never Apple's hämtningshistorik (Chrome: 10 of 10 messages)."
    },
    {
      "id": "download",
      "msgidPattern": "\\bdownload",
      "expect": "[Nn]edladd|[Ll]add\\p{L}* ned",
      "severity": "wrong",
      "reason": "Downloading is ladda ned, a download a nedladdning, as Chrome writes them (Chrome: 216 of 228 messages)."
    },
    {
      "id": "bookmark",
      "msgidPattern": "\\bbookmarks?\\b",
      "expect": "[Bb]okmärk",
      "severity": "wrong",
      "reason": "A bookmark is a bokmärke (Chrome: 163 of 163 messages)."
    },
    {
      "id": "notification",
      "msgidPattern": "(?!Notifications$).*\\bnotifications?\\b",
      "expect": "[Aa]viser",
      "severity": "wrong",
      "reason": "A notification is an avisering, as Chrome writes it. The bare Notifications is also the toasts' region, under the toast rule (Chrome: 124 of 127 messages)."
    },
    {
      "id": "extension",
      "msgidPattern": "\\bextensions?\\b",
      "expect": "[Tt]illägg",
      "severity": "wrong",
      "reason": "An extension is a tillägg (Chrome: 302 of 308 messages)."
    },
    {
      "id": "tab-strip",
      "msgidPattern": "\\btab strip\\b",
      "expect": "[Ff]likhuvud",
      "severity": "wrong",
      "reason": "The tab strip is the flikhuvud, as Chrome writes it (Chrome: 7 of 7 messages)."
    },
    {
      "id": "do-not-disturb",
      "msgidPattern": "\\bdo not disturb\\b",
      "expect": "Stör ej",
      "severity": "wrong",
      "reason": "Do Not Disturb is Stör ej (Chrome: 5 of 6 messages)."
    },
    {
      "id": "button",
      "msgidPattern": "\\bbuttons?\\b",
      "expect": "[Kk]napp",
      "severity": "wrong",
      "reason": "An on-screen button is a knapp, as Chrome writes it (Chrome: 139 of 141 messages)."
    },
    {
      "id": "password-manager",
      "msgidPattern": "\\bpassword managers?\\b",
      "expect": "[Ll]ösenordshanter",
      "severity": "wrong",
      "reason": "A password manager is a lösenordshanterare, as Chrome writes it (Chrome: 76 of 77 messages)."
    },
    {
      "id": "passkey",
      "msgidPattern": "\\bpasskeys?\\b",
      "expect": "(?<!\\p{L})[Nn]yck",
      "severity": "wrong",
      "reason": "A passkey is a nyckel, as Chrome writes it (Chrome: 106 of 106 messages)."
    },
    {
      "id": "default-browser",
      "msgidPattern": "\\bdefault browser\\b",
      "expect": "[Ss]tandardwebbläsare",
      "severity": "wrong",
      "reason": "The default browser is the standardwebbläsare, as Chrome writes it (Chrome: 11 of 11 messages)."
    },
    {
      "id": "update",
      "msgidPattern": "\\bupdat(?:e|es|ed|ing)\\b",
      "expect": "[Uu]ppdater",
      "severity": "wrong",
      "reason": "An update is an uppdatering (Chrome: 233 of 234 messages)."
    },
    {
      "id": "restart",
      "msgidPattern": "\\brestart",
      "expect": "[Ss]tart\\p{L}* om|[Oo]mstart",
      "severity": "wrong",
      "reason": "Restarting is starta om, as Chrome writes it (Chrome: 44 of 47 messages)."
    },
    {
      "id": "reload",
      "msgidPattern": "\\breload\\b",
      "expect": "[Ll]äs\\p{L}* in|[Ii]nläsning",
      "severity": "wrong",
      "reason": "Reloading is läsa in igen, as Chrome writes it, not Apple's Uppdatera, which is Meru's word for an update (Chrome: 25 of 32 messages)."
    },
    {
      "id": "titlebar",
      "msgidPattern": "\\btitle ?bar\\b",
      "expect": "[Nn]amnlist",
      "severity": "wrong",
      "reason": "The titlebar is the namnlist (Chrome: 5 of 5 messages)."
