    },
    {
      "id": "recargar",
      "pattern": "(?<!\\p{L})[Rr]ecarg\\p{L}*",
      "severity": "wrong",
      "reason": "Reloading is volver a cargar (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "inverted-marks",
      "pattern": "(?<!¿[^?\\n]*)\\?|(?<!¡[^!\\n]*)!",
      "severity": "wrong",
      "reason": "A question opens with ¿ and an exclamation with ¡."
    },
    {
      "id": "quotes",
      "pattern": "[\"«»]",
      "severity": "wrong",
      "reason": "Quotation marks are “…” (U+201C, U+201D), as Apple writes them, never straight quotes or «»; Chrome's straight quotes (253 messages, against 59 with “”) are its own style (Chrome writes the banned form in 208 messages)."
    },
    {
      "id": "three-periods",
      "pattern": "\\.\\.\\.",
      "severity": "wrong",
      "reason": "An ellipsis is the one character …, as Apple writes it, never three periods; Chrome's three periods are its own style."
    },
    {
      "id": "ellipsis-space",
      "pattern": "[ \\u00a0\\u202f]…",
      "severity": "wrong",
      "reason": "The ellipsis follows the word with no space, as Apple writes it (and Chrome, which never spaces it)."
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}])[\\u00a0\\u202f](?=(?:segundos?|minutos?|horas?|días?|semanas?|mes|meses|años?|[kKMGT]B)(?!\\p{L}))",
      "severity": "wrong",
      "reason": "A number and its unit are parted by a plain space, as Chrome writes them: 5 minutos, # días (Chrome writes the banned form in 41 messages)."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Ll]o sentimos|[Pp]or favor|[Dd]isculp\\p{L}*|[Ll]amentablemente)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Lo sentimos or Por favor."
    },
    {
      "id": "aplicacion",
      "pattern": "(?<!\\p{L})[Aa]plicaci[oó]n(?!\\p{L})",
      "severity": "wrong",
      "reason": "An app is an app, as Chrome writes it (423 of its 459 messages with app) and Gmail does (la app de Gmail, Gmail Help hl=es-419), never aplicación, also where the English says the application for Meru itself, the same thing; only macOS's Applications folder keeps Apple's plural, Aplicaciones (Chrome writes the banned form in 41 messages)."
    }
