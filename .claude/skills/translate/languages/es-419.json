  "banned": [
    {
      "id": "usted",
      "pattern": "(?<!\\p{L})(?:[Uu]sted(?:es)?|[Vv]os)(?!\\p{L})",
      "severity": "wrong",
      "reason": "The user is tú, never usted, ustedes or vos. Chrome: tú in 2,381 of the 3,772 messages that address the user, usted in none."
    },
    {
      "id": "ordenador",
      "pattern": "(?<!\\p{L})[Oo]rdenador(?:es)?(?!\\p{L})",
      "severity": "wrong",
      "reason": "A computer is a computadora in Latin America. Chrome: computadora in 75 of 82 messages, ordenador in none."
    },
    {
      "id": "anadir",
      "pattern": "(?<!\\p{L})[Aa]ñad\\p{L}*",
      "severity": "wrong",
      "reason": "Adding is agregar in Latin America. Chrome: agregar in 289 of 299 messages for add, añadir in 2."
    },
    {
      "id": "introducir",
      "pattern": "(?<!\\p{L})[Ii]ntroduc\\p{L}*",
      "severity": "wrong",
      "reason": "Entering text is ingresar in Latin America. Chrome: ingresar in 108 of 147 messages for enter, introducir in none."
    },
    {
      "id": "ajustes",
      "pattern": "(?<!\\p{L})[Aa]justes(?!\\p{L})",
      "severity": "wrong",
      "reason": "Settings is Configuración in Latin America. Chrome: Configuración in 409 of 416 messages for settings, Ajustes in none."
    },
    {
      "id": "no-se-ha-podido",
      "pattern": "[Nn]o se ha podido",
      "severity": "wrong",
      "reason": "A recent failure takes the simple past in Latin America: No se pudo. Chrome: No se pudo in 88 of 143 messages for couldn't, No se ha podido in none."
    },
    {
      "id": "anclar",
      "pattern": "(?<!\\p{L})(?:[Dd]es)?[Aa]ncl(?:a|ar|ad[oa]s?|e|en|as|an)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Pinning a tab is fijar and unpinning dejar de fijar, as Chrome writes them: fijar in 41 messages for pin, dejar de fijar in 18 of 20 for unpin, anclar in 1."
    },
    {
      "id": "enlace",
      "pattern": "(?<!\\p{L})[Ee]nlaces?(?!\\p{L})",
      "severity": "doubtful",
      "reason": "A link is a vínculo in Latin America. Chrome: vínculo in 160 of 190 messages for link, enlace in 1."
    },
    {
      "id": "marcador",
      "pattern": "(?<!\\p{L})[Mm]arcador(?:es)?(?!\\p{L})",
      "severity": "doubtful",
      "reason": "A bookmark is a favorito in Latin America. Chrome: favorito in 185 of 197 messages for bookmark, marcador in 12."
    },
    {
      "id": "recargar",
      "pattern": "(?<!\\p{L})[Rr]ecarg\\p{L}*",
      "severity": "doubtful",
      "reason": "Reloading is volver a cargar. Chrome: volver a cargar in 29 of 30 messages for reload, recargar in none."
    },
    {
      "id": "inverted-marks",
      "pattern": "(?<!¿[^?\\n]*)\\?|(?<!¡[^!\\n]*)!",
      "severity": "wrong",
      "reason": "A question opens with ¿ and an exclamation with ¡."
    },
    {
      "id": "quotes",
      "pattern": "[\"«»]",
      "severity": "wrong",
      "reason": "Quotation marks are “…” (U+201C, U+201D), as Apple writes them, never straight quotes or «»; Chrome's straight quotes (253 messages, against 59 with “”) are its own style."
    },
    {
      "id": "three-periods",
      "pattern": "\\.\\.\\.",
      "severity": "style",
      "reason": "An ellipsis is the one character …, as Apple writes it, never three periods; Chrome's three periods are its own style."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Ll]o sentimos|[Pp]or favor|[Dd]isculp\\p{L}*|[Ll]amentablemente)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Lo sentimos or Por favor."
    }
  ],
