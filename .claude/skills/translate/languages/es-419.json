  "banned": [
    {
      "id": "usted",
      "pattern": "(?<!\\p{L})(?:[Uu]sted(?:es)?|[Vv]os)(?!\\p{L})",
      "severity": "wrong",
      "reason": "The user is tú, never usted, ustedes or vos (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "ordenador",
      "pattern": "(?<!\\p{L})[Oo]rdenador(?:es)?(?!\\p{L})",
      "severity": "wrong",
      "reason": "A computer is a computadora in Latin America (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "anadir",
      "pattern": "(?<!\\p{L})[Aa]ñad\\p{L}*",
      "severity": "wrong",
      "reason": "Adding is agregar in Latin America (Chrome writes the banned form in 2 messages)."
    },
    {
      "id": "introducir",
      "pattern": "(?<!\\p{L})[Ii]ntroduc\\p{L}*",
      "severity": "wrong",
      "reason": "Entering text is ingresar in Latin America (Chrome writes the banned form in 1 message)."
    },
    {
      "id": "ajustes",
      "pattern": "(?<!\\p{L})[Aa]justes(?!\\p{L})",
      "severity": "wrong",
      "reason": "Settings is Configuración in Latin America (Chrome writes the banned form in 1 message)."
    },
    {
      "id": "no-se-ha-podido",
      "pattern": "[Nn]o se ha podido",
      "severity": "wrong",
      "reason": "A recent failure takes the simple past in Latin America: No se pudo (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "anclar",
      "pattern": "(?<!\\p{L})(?:[Dd]es)?[Aa]ncl(?:a|ar|ad[oa]s?|e|en|as|an)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Pinning a tab is fijar and unpinning dejar de fijar, as Chrome writes them: fijar in 41 messages for pin, dejar de fijar in 18 of 20 for unpin, anclar in 1 (Chrome writes the banned form in 3 messages)."
    },
    {
      "id": "enlace",
      "pattern": "(?<!\\p{L})[Ee]nlaces?(?!\\p{L})",
      "severity": "wrong",
      "reason": "A link is a vínculo in Latin America (Chrome writes the banned form in 3 messages)."
    },
    {
      "id": "marcador",
      "pattern": "(?<!\\p{L})[Mm]arcador(?:es)?(?!\\p{L})",
      "severity": "wrong",
      "reason": "A bookmark is a favorito in Latin America (Chrome writes the banned form in 13 messages)."
    },
    {
      "id": "recargar",
      "pattern": "(?<!\\p{L})[Rr]ecarg\\p{L}*",
      "severity": "wrong",
      "reason": "Reloading is volver a cargar (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "inverted-marks",
      "pattern": "(?<!¿[^?\\n]*)\\?|(?<!¡[^!\\n]*)!",
      "severity": "wrong",
      "reason": "A question opens with ¿ and an exclamation with ¡."
    },
    {
      "id": "quotes",
      "pattern": "[\"«»]",
      "severity": "wrong",
      "reason": "Quotation marks are “…” (U+201C, U+201D), as Apple writes them, never straight quotes or «»; Chrome's straight quotes (253 messages, against 59 with “”) are its own style (Chrome writes the banned form in 208 messages)."
    },
    {
      "id": "three-periods",
      "pattern": "\\.\\.\\.",
      "severity": "wrong",
      "reason": "An ellipsis is the one character …, as Apple writes it, never three periods; Chrome's three periods are its own style."
    },
    {
      "id": "ellipsis-space",
      "pattern": "[ \\u00a0\\u202f]…",
      "severity": "wrong",
      "reason": "The ellipsis follows the word with no space, as Apple writes it (and Chrome, which never spaces it)."
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}])[\\u00a0\\u202f](?=(?:segundos?|minutos?|horas?|días?|semanas?|mes|meses|años?|[kKMGT]B)(?!\\p{L}))",
      "severity": "wrong",
      "reason": "A number and its unit are parted by a plain space, as Chrome writes them: 5 minutos, # días (Chrome writes the banned form in 41 messages)."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Ll]o sentimos|[Pp]or favor|[Dd]isculp\\p{L}*|[Ll]amentablemente)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Lo sentimos or Por favor."
    }
  ],
