      "severity": "wrong",
      "reason": "A recent failure takes the simple past in Latin America: No se pudo (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "anclar",
      "pattern": "(?<!\\p{L})(?:[Dd]es)?[Aa]ncl(?:a|ar|ad[oa]s?|e|en|as|an)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Pinning a tab is fijar and unpinning dejar de fijar, as Chrome writes them: fijar in 41 messages for pin, dejar de fijar in 18 of 20 for unpin, anclar in 1 (Chrome writes the banned form in 3 messages)."
    },
    {
      "id": "enlace",
      "pattern": "(?<!\\p{L})[Ee]nlaces?(?!\\p{L})",
      "severity": "wrong",
      "reason": "A link is a vínculo in Latin America (Chrome writes the banned form in 3 messages)."
