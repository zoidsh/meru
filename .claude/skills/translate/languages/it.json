  "banned": [
    {
      "id": "pannello",
      "pattern": "(?<!\\p{L})[Pp]annell[oi](?!\\p{L})(?!\\s+laterale)",
      "severity": "wrong",
      "reason": "A tab is a scheda, plural schede, as Chrome writes it, never Apple's pannello (Chrome: 792 messages, none with pannello)."
    },
    {
      "id": "tabstrip",
      "pattern": "[Tt]ab ?strip",
      "severity": "wrong",
      "reason": "The tab strip is the barra delle schede, the user's call against Chrome's loanword tabstrip (Chrome: 8 of 8 messages)."
    },
    {
      "id": "segnalibro",
      "pattern": "(?<!\\p{L})[Ss]egnalibr[oi](?!\\p{L})",
      "severity": "wrong",
      "reason": "A bookmark is a preferito, plural preferiti, as Chrome writes it (Chrome: 194 messages, 8 with segnalibro)."
    },
    {
      "id": "e-mail",
      "pattern": "(?<!\\p{L})[Ee]-mail(?!\\p{L})",
      "severity": "wrong",
      "reason": "An email is an email, with no hyphen, as Chrome writes it (Chrome: 59 messages, none with e-mail)."
    },
    {
      "id": "cliccare",
      "pattern": "(?<!\\p{L})[Cc]lic(?:ca|care|cando|cate|chi)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Clicking is fare clic, as in Fai clic su, as Chrome writes it (Chrome: 122 messages, none with cliccare)."
    },
    {
      "id": "accounts",
      "pattern": "(?<![\\p{L}\\p{N}{])[Aa]ccounts(?![\\p{L}\\p{N}}])",
      "severity": "wrong",
      "reason": "account is invariable, gli account, as Apple and Chrome write it (Chrome: 56 messages, none with accounts)."
    },
    {
      "id": "ellipsis",
      "pattern": "\\.\\.\\.|[ \\u00a0\\u202f]…",
      "severity": "wrong",
      "reason": "An ellipsis is … (U+2026) straight after the word, as Apple and Chrome write it (Chrome: 208 messages, 1 with a space before it)."
    },
    {
      "id": "quotes",
      "pattern": "[\"«»]",
      "severity": "wrong",
      "reason": "Quotation marks are “ ” (U+201C, U+201D), as Apple writes Cerca info su “%@”; Chrome's straight quotes are not adopted."
    },
    {
      "id": "apostrophe",
      "pattern": "'",
      "severity": "wrong",
      "reason": "The apostrophe is ’ (U+2019), as Apple writes it; Chrome's straight ' is not adopted."
    },
    {
      "id": "lei",
      "pattern": "(?<=[\\p{Ll},;:] )(?:Lei|Suo|Sua|Suoi|Sue)(?!\\p{L})",
      "severity": "wrong",
      "reason": "The user is tu, with tuo, tua and ti, never Lei."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Ss]piacenti|[Cc]i dispiace)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Spiacenti or Ci dispiace."
    }
  ],
