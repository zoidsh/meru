  "banned": [
    {
      "id": "pannello",
      "pattern": "(?<!\\p{L})[Pp]annell[oi](?!\\p{L})(?!\\s+laterale)",
      "severity": "wrong",
      "reason": "A tab is a scheda, plural schede, as Chrome writes it, never Apple's pannello (Chrome writes the banned form in 1 message)."
    },
    {
      "id": "segnalibro",
      "pattern": "(?<!\\p{L})[Ss]egnalibr[oi](?!\\p{L})",
      "severity": "wrong",
      "reason": "A bookmark is a preferito, plural preferiti, as Chrome writes it (Chrome writes the banned form in 6 messages)."
    },
    {
      "id": "e-mail",
      "pattern": "(?<!\\p{L})[Ee]-mail(?!\\p{L})",
      "severity": "wrong",
      "reason": "An email is an email, with no hyphen, as Chrome writes it (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "cliccare",
      "pattern": "(?<!\\p{L})[Cc]lic(?:ca|care|cando|cate|chi)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Clicking is fare clic, as in Fai clic su, as Chrome writes it (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "accounts",
      "pattern": "(?<![\\p{L}\\p{N}{])[Aa]ccounts(?![\\p{L}\\p{N}}])",
      "severity": "wrong",
      "reason": "account is invariable, gli account, as Apple and Chrome write it (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "ellipsis",
      "pattern": "\\.\\.\\.|[ \\u00a0\\u202f]…",
      "severity": "wrong",
      "reason": "An ellipsis is … (U+2026) straight after the word, as Apple and Chrome write it (Chrome writes the banned form in 117 messages)."
    },
    {
      "id": "quotes",
      "pattern": "[\"«»]",
      "severity": "wrong",
      "reason": "Quotation marks are “ ” (U+201C, U+201D), as Apple writes Cerca info su “%@”; Chrome's straight quotes are not adopted."
    },
    {
      "id": "apostrophe",
      "pattern": "'",
      "severity": "wrong",
      "reason": "The apostrophe is ’ (U+2019), as Apple writes it; Chrome's straight ' is not adopted."
    },
    {
      "id": "lei",
      "pattern": "(?<=[\\p{Ll},;:] )(?:Lei|Suo|Sua|Suoi|Sue)(?!\\p{L})",
      "severity": "wrong",
      "reason": "The user is tu, with tuo, tua and ti, never Lei."
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}])[\\u00a0\\u202f](?=(?:secondi?|minuti?|ore|ora|giorni?|settimane?|mesi?|anni?|[kKMGT]B)(?!\\p{L}))",
      "severity": "wrong",
      "reason": "A number and its unit are parted by a plain space, as Chrome writes them: 5 minuti, # giorni (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Ss]piacenti|[Cc]i dispiace)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Spiacenti or Ci dispiace."
    }
  ],
  "pinned": [
    {
      "id": "download-history",
      "msgidPattern": "(?<!recent )\\bdownload history\\b",
      "expect": "[Cc]ronologia (?:dei )?download",
      "severity": "wrong",
      "reason": "The download history is cronologia dei download, as Chrome writes it, in its title and in Close download history and Full download history (Chrome: 8 of 8 messages)."
    },
    {
      "id": "recent-downloads",
      "msgidPattern": "\\brecent download history\\b",
      "expect": "download recenti",
      "severity": "wrong",
      "reason": "The recent download history popup is Cronologia dei download recenti, as Chrome writes it (Chrome: 2 of 2 messages)."
    },
    {
      "id": "gmail-label",
      "msgidPattern": "\\blabel\\b",
      "msgctxt": "Gmail label",
      "expect": "[Ee]tichett",
      "severity": "wrong",
      "reason": "A Gmail label is Gmail's etichetta (glossary), as Chrome also writes it."
    },
    {
      "id": "bookmark",
      "msgidPattern": "\\bbookmarks?\\b",
      "expect": "[Pp]referit",
      "severity": "wrong",
      "reason": "A bookmark is a preferito, as Chrome writes it: Preferiti, Aggiungi ai Preferiti (Chrome: 158 of 163 messages)."
    },
    {
      "id": "tab-strip",
      "msgidPattern": "\\btab strip\\b",
      "expect": "tabstrip",
      "severity": "wrong",
