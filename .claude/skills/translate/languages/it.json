      "severity": "wrong",
      "reason": "An update is an aggiornamento, and to update is aggiornare, as Chrome writes them (Chrome: 191 of 192 messages)."
    },
    {
      "id": "restart",
      "msgidPattern": "\\brestarts?\\b",
      "expect": "[Rr]iavvi",
      "severity": "wrong",
      "reason": "Restarting is riavviare, a restart a riavvio, as Chrome writes them (Chrome: 46 of 46 messages)."
    },
    {
      "id": "reload",
      "msgidPattern": "\\breload\\b",
      "expect": "[Rr]icaric",
      "severity": "wrong",
