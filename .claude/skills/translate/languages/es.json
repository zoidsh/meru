  "banned": [
    {
      "id": "usted",
      "pattern": "(?<!\\p{L})(?:[Uu]sted(?:es)?|[Vv]osotr[oa]s|[Vv]uestr[oa]s?)(?!\\p{L})",
      "severity": "wrong",
      "reason": "The user is tú, never usted or vosotros (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "computadora",
      "pattern": "(?<!\\p{L})[Cc]omputadoras?(?!\\p{L})",
      "severity": "wrong",
      "reason": "A computer is an ordenador in Spain (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "agregar",
      "pattern": "(?<!\\p{L})[Aa]greg(?:a|ar|ad[oa]s?|ue|uen|as|an|ando)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Adding is añadir in Spain (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "ingresar",
      "pattern": "(?<!\\p{L})[Ii]ngres(?:a|ar|ad[oa]s?|e|en|as|an|ando)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Entering text is introducir in Spain (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "ajustes",
      "pattern": "(?<!\\p{L})[Aa]justes(?!\\p{L})",
      "severity": "wrong",
      "reason": "Settings is Configuración in Meru's own copy, as Chrome writes it. Ajustes is Apple's word, for a macOS label such as the app menu's Ajustes… and for macOS's own Ajustes del Sistema (Chrome writes the banned form in 143 messages).",
      "allow": {
        "contexts": ["macOS"],
        "msgidPattern": "\\bSystem Settings\\b"
      }
    },
    {
      "id": "no-se-pudo",
      "pattern": "[Nn]o se pudo",
      "severity": "wrong",
      "reason": "A recent failure takes the perfect in Spain: No se ha podido (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "anclar",
      "pattern": "(?<!\\p{L})(?:[Dd]es)?[Aa]ncl(?:a|ar|ad[oa]s?|e|en|as|an)(?!\\p{L})",
      "severity": "wrong",
      "reason": "Pinning a tab is fijar and unpinning desfijar, as Chrome writes them: fijar in 44 messages for pin, desfijar in 17 of 20 for unpin, anclar in none (Chrome writes the banned form in 1 message)."
    },
    {
      "id": "app",
      "pattern": "(?<!\\p{L})[Aa]pps?(?!\\p{L})",
      "severity": "wrong",
      "reason": "An app is an aplicación in Spain, as Chrome writes it: aplicación in 527 of 566 messages for app, app in 23. Apple's apps stays in a macOS label such as Ocultar otras apps (Chrome writes the banned form in 25 messages).",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "vinculo",
      "pattern": "(?<!\\p{L})[Vv]ínculos?(?!\\p{L})",
      "severity": "wrong",
      "reason": "A link is an enlace in Spain (Chrome writes the banned form in none of its messages)."
    },
    {
      "id": "recargar",
      "pattern": "(?<!\\p{L})[Rr]ecarg\\p{L}*",
      "severity": "wrong",
      "reason": "Reloading is volver a cargar (Chrome writes the banned form in 2 messages)."
    },
    {
      "id": "inverted-marks",
      "pattern": "(?<!¿[^?\\n]*)\\?|(?<!¡[^!\\n]*)!",
      "severity": "wrong",
      "reason": "A question opens with ¿ and an exclamation with ¡."
    },
    {
      "id": "quotes",
      "pattern": "[\"«»]",
      "severity": "wrong",
      "reason": "Quotation marks are “…” (U+201C, U+201D), as Apple writes them, never straight quotes or «»; Chrome's straight quotes (205 messages) are its own style (Chrome writes the banned form in 169 messages)."
    },
    {
      "id": "three-periods",
      "pattern": "\\.\\.\\.",
      "severity": "wrong",
      "reason": "An ellipsis is the one character …, as Apple writes it, never three periods; Chrome's three periods are its own style."
    },
    {
      "id": "ellipsis-space",
      "pattern": "[ \\u00a0\\u202f]…",
      "severity": "wrong",
      "reason": "The ellipsis follows the word with no space, as Apple writes it (and Chrome, which never spaces it)."
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}])[\\u00a0\\u202f](?=(?:segundos?|minutos?|horas?|días?|semanas?|mes|meses|años?|[kKMGT]B)(?!\\p{L}))",
      "severity": "wrong",
      "reason": "A number and its unit are parted by a plain space, as Chrome writes them: 5 minutos, # días (Chrome writes the banned form in 19 messages)."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Ll]o sentimos|[Pp]or favor|[Dd]isculp\\p{L}*|[Ll]amentablemente)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Lo sentimos or Por favor."
    }
  ],
  "pinned": [
