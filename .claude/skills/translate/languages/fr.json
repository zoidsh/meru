  "banned": [
    {
      "id": "reglages",
      "pattern": "(?<!\\p{L})[Rr]églages?(?!\\p{L})",
      "severity": "wrong",
      "reason": "Settings is Paramètres in Meru's own copy, as Chrome writes it (Chrome: 390 of 417 messages for settings, 18 with réglages). Réglages is Apple's word, for a macOS label such as the app menu's Réglages… and for macOS's own Réglages Système.",
      "allow": {
        "contexts": ["macOS"],
        "msgidPattern": "\\bSystem Settings\\b"
      }
    },
    {
      "id": "signet",
      "pattern": "(?<!\\p{L})[Ss]ignets?(?!\\p{L})",
      "severity": "wrong",
      "reason": "A bookmark is a favori, plural favoris, as Chrome writes it, never a signet (Chrome: 200 messages, none with signet)."
    },
    {
      "id": "app",
      "pattern": "(?<![\\p{L}\\p{N}./@{-])[Aa]pps?(?![\\p{L}\\p{N}}-])",
      "severity": "wrong",
      "reason": "An app is an appli, plural applis, as Chrome writes it, or in full an application; never app (Chrome: 368 messages with appli, 3 with app)."
    },
    {
      "id": "email",
      "pattern": "(?<![\\p{L}\\p{N}{-])[Ee]mails?(?![\\p{L}\\p{N}}-])",
      "severity": "wrong",
      "reason": "An email is an e-mail, with the hyphen, as Chrome writes it (Chrome: 57 messages, none with email)."
    },
    {
      "id": "site-web",
      "pattern": "(?<!\\p{L})[Ss]ites? web(?!\\p{L})",
      "severity": "wrong",
      "reason": "Chrome writes site Web, with a capital W (Chrome: 109 messages, 1 with site web)."
    },
    {
      "id": "presse-papier",
      "pattern": "(?<!\\p{L})[Pp]resse-papier(?!s)",
      "severity": "wrong",
      "reason": "The clipboard is the presse-papiers, as Chrome writes it (Chrome: 37 messages, 3 with presse-papier)."
    },
    {
      "id": "ellipsis",
      "pattern": "\\.\\.\\.|[ \\u00a0\\u202f]…",
      "severity": "wrong",
      "reason": "An ellipsis is … (U+2026) straight after the word, as Apple and Chrome write it (Chrome: 208 messages, 1 with a space before it)."
    },
    {
      "id": "punctuation-space",
      "pattern": "(?<!\\u00a0)[;?!]|(?<![\\u00a0\\p{N}]):(?!//)",
      "severity": "wrong",
      "reason": "A no-break space (U+00A0) goes before : ; ? and !, as Chrome writes it: Voulez-vous vraiment … ? (Chrome: 428 messages with ?, 566 with :, 10 of them with a plain space before :)."
    },
    {
      "id": "unit-space",
      "pattern": "(?<=[\\p{N}#}]) (?=(?:secondes?|minutes?|heures?|jours?|semaines?|mois|ans|[kKMGT]o|%)(?!\\p{L}))|(?<=[\\p{N}#}])%",
      "severity": "wrong",
      "reason": "A number and its unit, or %, are joined by a no-break space (U+00A0), as Chrome writes them: 5 minutes, # jours, 50 % (Chrome: 150 messages with a unit, 1 with a plain space, and 37 with %)."
    },
    {
      "id": "quotes",
      "pattern": "[\"“”]",
      "severity": "wrong",
      "reason": "Quotation marks are « » with no-break spaces inside: « Paramètres ». Chrome's straight quotes are not adopted."
    },
    {
      "id": "guillemet-space",
      "pattern": "«(?!\\u00a0)|(?<!\\u00a0)»",
      "severity": "wrong",
      "reason": "A no-break space (U+00A0) goes inside « », as Apple writes « %@ »."
    },
    {
      "id": "apostrophe",
      "pattern": "'",
      "severity": "wrong",
      "reason": "The apostrophe is ’ (U+2019), as Apple writes it; Chrome's straight ' is not adopted."
    },
    {
      "id": "tu",
      "pattern": "(?<![\\p{L}\\p{N}+])(?:[Tt]u|[Tt]oi|[Tt]on|[Tt]es|[Tt]a|[Tt]e)(?![\\p{L}\\p{N}+])|(?<![\\p{L}\\p{N}+])[Tt][’'](?=\\p{L})",
      "severity": "wrong",
      "reason": "The user is vous, with votre and vos, never tu, toi, te, t’, ton, ta or tes."
    },
    {
      "id": "apology",
      "pattern": "(?<!\\p{L})(?:[Dd]ésolée?s?|[Vv]euillez)(?!\\p{L})",
      "severity": "style",
      "reason": "Say what happened, without Désolé or Veuillez."
    }
  ],
