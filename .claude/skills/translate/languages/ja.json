  "banned": [
    {
      "id": "uindou",
      "pattern": "ウインドウ",
      "severity": "wrong",
      "reason": "A window is ウィンドウ in Meru's own copy; ウインドウ is Apple's spelling, for a macOS label only.",
      "allow": {
        "contexts": ["macOS"]
      }
    },
    {
      "id": "long-vowel",
      "pattern": "(?:ブラウザ|フォルダ|ユーザ|マネージャ|コンピュータ)(?!ー)",
      "severity": "wrong",
      "reason": "A word ending in a long vowel keeps its ー: ブラウザー, フォルダー, ユーザー."
    },
    {
      "id": "kakuchou-kinou",
      "pattern": "拡張機能",
      "severity": "wrong",
      "reason": "An extension is 機能拡張, never 拡張機能."
    },
    {
      "id": "anata",
      "pattern": "あなた",
      "severity": "wrong",
      "reason": "No pronoun for the user: never あなた."
    },
    {
      "id": "full-width-marks",
      "pattern": "[？！]",
      "severity": "wrong",
      "reason": "A question or exclamation mark is the half-width ? or !."
    },
    {
      "id": "quotes",
      "pattern": "[「」『』\"]",
      "severity": "wrong",
      "reason": "Quotation marks are “” (U+201C, U+201D), never 「」 or straight quotes."
    },
    {
      "id": "half-width-punctuation",
      "pattern": "(?<=[\\p{sc=Hiragana}\\p{sc=Katakana}\\p{sc=Han}ー])[,.]",
      "severity": "wrong",
      "reason": "The comma is 、 and the full stop 。 in Japanese text."
    },
    {
      "id": "latin-spacing",
      "pattern": "(?<=[\\p{sc=Hiragana}\\p{sc=Katakana}\\p{sc=Han}ー、。]) (?=[\\p{sc=Latin}\\p{N}{<])|(?<=[\\p{sc=Latin}\\p{N}}>]) (?=[\\p{sc=Hiragana}\\p{sc=Katakana}\\p{sc=Han}ー])",
      "severity": "wrong",
      "reason": "No space around Latin text, numbers or placeholders: Meru Proにアップグレード."
    },
    {
      "id": "apology",
      "pattern": "すみません|申し訳ありません",
      "severity": "style",
      "reason": "Say what happened, without すみません or 申し訳ありません."
    }
  ],
