<?xml version="1.0" encoding="utf-8"?><martif type="TBX" xml:lang="en-US"><text><body><termEntry id="11991_39848_39866"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To duplicate data and reproduce it in another part of a document.</descrip></descripGrp><ntig><termGrp><term id="39848">copy</term></termGrp></ntig></langSet><langSet xml:lang="nl"><ntig><termGrp><term id="39866">kopiëren</term></termGrp></ntig></langSet></termEntry><termEntry id="7275_1764513_702747"><langSet xml:lang="en-US"><ntig><termGrp><term id="1764513">copy</term></termGrp></ntig></langSet><langSet xml:lang="nl"><ntig><termGrp><term id="702747">exemplaar</term></termGrp></ntig></langSet></termEntry><termEntry id="9679_334563_1103965"><langSet xml:lang="en-US"><descripGrp><descrip type="definition">To close a program &amp; its windows.</descrip></descripGrp><ntig><termGrp><term id="334563">quit</term></termGrp></ntig></langSet><langSet xml:lang="nl"><ntig><termGrp><term id="1103965">afsluiten</term></termGrp></ntig></langSet></termEntry></body></text></martif>
