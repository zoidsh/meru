#. Title of the window that picks a screen or a window to share in a Google Meet call
#: packages/app/account.ts
msgid "Choose what to share"
msgstr "Wähle aus, was du teilen möchtest"

#. An item in the context menu of a page or a text field; & marks the access key on Windows and Linux
#: packages/app/context-menu.ts
msgid "&Search with Google"
msgstr "Mit Google &suchen"

#. appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/dialogs.ts
msgid "{target, select, window {Open {appLabel} links in this window?} other {Open {appLabel} links in this tab?}}"
msgstr "{target, select, window {{appLabel}-Links in diesem Fenster öffnen?} other {{appLabel}-Links in diesem Tab öffnen?}}"

#: packages/app/downloads.ts
msgid "Downloaded {fileName}"
msgstr "{fileName} heruntergeladen"

#: packages/app/gmail/index.ts
msgid "Copied verification code {verificationCode}"
msgstr "Bestätigungscode {verificationCode} kopiert"

#. An item in the context menu of a Google Workspace app's tab
#: packages/app/ipc.ts
msgid "Move to New Window"
msgstr "In neues Fenster verschieben"

#. An item in the context menu of a Google Workspace app's tab
#: packages/app/ipc.ts
msgid "Unpin"
msgstr "Loslösen"

#. name is the name of a browser extension, such as Bitwarden
#: packages/app/lib/extension-swap.ts
msgid "{name} is still on."
msgstr "{name} ist noch aktiviert."

#: packages/app/license-key.ts
msgid "This license key is invalid. Contact support if you need help."
msgstr "Dieser Lizenzschlüssel ist ungültig. Wende dich an den Support, wenn du Hilfe brauchst."

#. A menu or a menu item in Meru's menu bar
#: packages/app/menu.ts
msgctxt "Windows"
msgid "About {appName}"
msgstr "Info zu {appName}"

#. A menu or a menu item in Meru's menu bar
#: packages/app/menu.ts
msgid "Find…"
msgstr "Suchen …"

#. A menu or a menu item in Meru's menu bar
#: packages/app/menu.ts
msgid "Manage Accounts"
msgstr "Konten verwalten"

#: packages/app/menu.ts
msgid "This signs out of every account and clears all settings and data on this device. It can't be undone."
msgstr "Dadurch wirst du von allen Konten abgemeldet, und alle Einstellungen und Daten auf diesem Gerät werden gelöscht. Das kann nicht rückgängig gemacht werden."

#: packages/renderer/components/app-titlebar.tsx
msgid "Scroll accounts right"
msgstr "Konten nach rechts scrollen"

#: packages/renderer/components/download-history.tsx
msgid "Files you download appear here for 30 days."
msgstr "Heruntergeladene Dateien werden hier 30 Tage lang angezeigt."

#: packages/renderer/routes/settings/accounts.tsx
msgid "Remove {label}?"
msgstr "{label} entfernen?"

#: packages/renderer/routes/settings/appearance.tsx
msgid "Restrict minimum window size"
msgstr "Mindestgröße für das Fenster festlegen"

#: packages/renderer/routes/settings/extensions.tsx
msgid "Couldn't uninstall {extensionName}"
msgstr "{extensionName} konnte nicht deinstalliert werden"

#: packages/renderer/routes/settings/extensions.tsx
msgid "Run the installed extensions. Turning this off stops them without uninstalling them."
msgstr "Die installierten Erweiterungen ausführen. Ist diese Option aus, werden sie angehalten, aber nicht deinstalliert."

#. The out-of-office banner is the one Gmail shows while an out-of-office reply is on, so it follows Gmail's word for it
#: packages/renderer/routes/settings/gmail/index.tsx
msgid "Hide out-of-office banner"
msgstr "Banner für Abwesenheitsnotiz ausblenden"

#. Option of the Categories to monitor setting. Primary is Gmail's inbox category of that name, so it follows Gmail's word for it
#: packages/renderer/routes/settings/gmail/index.tsx
msgid "Primary only"
msgstr "Nur Allgemein"

#. Spellchecker languages chosen beyond the system language, counted once there are more than two to name
#: packages/renderer/routes/settings/languages.tsx
msgid "{selectedCount, plural, one {# additional language} other {# additional languages}}"
msgstr "{selectedCount, plural, one {# zusätzliche Sprache} other {# zusätzliche Sprachen}}"

#: packages/renderer/routes/settings/notifications.tsx
msgid "Play a sound when showing a notification."
msgstr "Beim Anzeigen einer Benachrichtigung einen Ton abspielen."

#. Sits between a start time field and an end time field, as in 09:00 to 17:00
#: packages/renderer/routes/settings/notifications.tsx
msgid "to"
msgstr "bis"

#: packages/renderer/routes/settings/unified-inbox.tsx
msgid "Show all unread messages from every account in a single unified inbox."
msgstr "Alle ungelesenen Nachrichten aller Konten in einem kombinierten Posteingang anzeigen."

#. Name of a keyboard key, as printed on keyboards in that language, e.g. German Windows keyboards print Strg for Ctrl
#: packages/renderer/routes/settings/workspace-apps.tsx
msgid "Ctrl"
msgstr "Strg"

#: packages/renderer/routes/settings/workspace-apps.tsx
msgid "Persist zoom"
msgstr "Zoomstufe beibehalten"

#. Button on a message in the unified inbox. A Gmail action, so it follows Gmail's word for it
#: packages/renderer/routes/unified-inbox.tsx
msgid "Mark as read"
msgstr "Als gelesen markieren"

#. Titlebar badge counting the whole days left in the Meru Pro trial
#: packages/renderer/components/app-titlebar.tsx
msgid "{trialDaysLeft, plural, one {Pro trial ends in # day} other {Pro trial ends in # days}}"
msgstr "{trialDaysLeft, plural, one {Pro-Testzeitraum endet in # Tag} other {Pro-Testzeitraum endet in # Tagen}}"

#: packages/app/trial.ts
msgid "Your Meru Pro trial has ended."
msgstr "Dein Testzeitraum für Meru Pro ist abgelaufen."

#. installFolder is the folder Meru is installed in on Windows, which stays as it is
#: packages/renderer/routes/settings/extensions.tsx
msgid "Choose Meru in <0>{installFolder}</0>."
msgstr "Wähle Meru in <0>{installFolder}</0> aus."

# catalog: preload-gmail
#. Button in the message-sent toast, which recalls the message
#: packages/preload-gmail/ipc.ts
msgctxt "button"
msgid "Undo"
msgstr "Rückgängig machen"


# expect: accuracy/mistranslation major
# real: the cold second pass of #1246 caught it; an account isn't unread
# few-shot
#: packages/renderer/routes/settings/appearance.tsx
msgid "Select first unread account on click"
msgstr "Beim Klicken das erste ungelesene Konto auswählen"

# expect: terminology minor
# after #1246's fix round, which banned Schaltfläche for Button
#: packages/renderer/routes/settings/workspace-apps.tsx
msgid "Show width button"
msgstr "Breiten-Schaltfläche anzeigen"

# expect: terminology minor
# real: Testversion, which the glossary settled as Testzeitraum by Google's wording
#: packages/app/trial.ts
msgid "Couldn't validate your Meru Pro trial."
msgstr "Deine Testversion von Meru Pro konnte nicht überprüft werden."

# expect: terminology minor
# real: an MQM minor fixed in #1246; Chrome's item is Untersuchen
#. Context menu item that opens the developer tools on the element clicked
#: packages/app/context-menu.ts
msgid "Inspect Element"
msgstr "Element untersuchen"

# expect: terminology|accuracy/mistranslation minor
# after the Leinen call: the glossary names the sound Leinen; Leinwand is a canvas
#. Name of a notification sound, picked in Settings
#: packages/renderer/lib/notifications/index.ts
msgid "Linen"
msgstr "Leinwand"

# expect: terminology minor
# after #1246's fix round, which took Chrome's inaktiv for a hibernated tab
#: packages/renderer/routes/settings/workspace-apps.tsx
msgid "Hibernate idle tabs"
msgstr "Unbenutzte Tabs in den Ruhezustand versetzen"

# expect: terminology minor
# after the ban on Account, for Chrome's Konto
#: packages/renderer/routes/settings/accounts.tsx
msgid "Add account"
msgstr "Account hinzufügen"

# expect: terminology minor
# after the ban on the coined Ungelesen-Badge, for the glossary's Kennzeichen für ungelesene E-Mails
#: packages/renderer/routes/settings/appearance.tsx
msgid "Show unread badges"
msgstr "Ungelesen-Badges anzeigen"

# expect: accuracy/mistranslation major
# planted: wrong meaning, the opposite direction
#: packages/renderer/components/app-titlebar.tsx
msgid "Scroll accounts left"
msgstr "Konten nach rechts scrollen"

# expect: accuracy/mistranslation critical
# planted: a button that says the opposite of what it does
#: packages/renderer/routes/settings/license.tsx
msgid "Activate license key"
msgstr "Lizenzschlüssel deaktivieren"

# expect: accuracy/omission major
# planted: omission of unless you upgrade
#: packages/app/trial.ts
msgid "Meru Pro features stay on until you quit Meru. After that, Meru continues with the free version unless you upgrade."
msgstr "Die Meru-Pro-Funktionen bleiben aktiv, bis du Meru beendest. Danach läuft Meru mit der kostenlosen Version weiter."

# expect: accuracy/addition major
# planted: addition; clearing cookies would sign every account out
#. A menu or a menu item in Meru's menu bar
#: packages/app/menu.ts
msgid "Clear Cache"
msgstr "Cache und Cookies leeren"

# expect: accuracy/omission|accuracy/addition|accuracy/mistranslation critical
# planted: a broken placeholder, translated
#. origin is the scheme and host of a website, such as https://example.com
#: packages/app/url.ts
msgid "Trust all links on {origin}"
msgstr "Allen Links auf {Ursprung} vertrauen"

# expect: accuracy/omission|accuracy/mistranslation critical
# planted: a broken tag, the closing </0> dropped
#. allowlistEntry is the line to add to 1Password's list of allowed browsers, which stays as it is
#: packages/renderer/routes/settings/extensions.tsx
msgid "Add <0>{allowlistEntry}</0> on its own line, then save."
msgstr "Füge <0>{allowlistEntry} in einer eigenen Zeile hinzu und speichere dann."

# expect: fluency/punctuation|locale-conventions minor
# planted: straight quotation marks for „…“
#: packages/renderer/routes/settings/appearance.tsx
msgid "Show Do Not Disturb button"
msgstr "Button \"Nicht stören\" anzeigen"

# expect: style minor
# planted: Sie for the style sheet's du
#: packages/renderer/routes/settings/saved-searches.tsx
msgid "Enter a search query"
msgstr "Geben Sie eine Suchanfrage ein"
