msgstr "Twój okres próbny Meru Pro się zakończył. Funkcje Meru Pro pozostaną włączone do zakończenia działania Meru."

# expect: accuracy/mistranslation major
# planted: near miss, current for default
# hard
#: packages/renderer/routes/settings/general.tsx
msgid "Meru is set as the default mail client."
msgstr "Meru jest ustawiony jako bieżący klient poczty e-mail."

# expect: fluency/grammar|style minor
# planted: the perfective imperative of a one-off button for a setting that checks again and again, which takes the imperfective Sprawdzaj
# hard
#: packages/renderer/routes/settings/updates.tsx
msgid "Check for updates automatically"
msgstr "Sprawdź aktualizacje automatycznie"

# expect: fluency/grammar minor
# planted: the few and many branches swapped, # dodatkowych języków for 2 to 4 and # dodatkowe języki for 5 and more
# hard
#. Spellchecker languages chosen beyond the system language, counted once there are more than two to name
#: packages/renderer/routes/settings/languages.tsx
msgid "{selectedCount, plural, one {# additional language} other {# additional languages}}"
msgstr "{selectedCount, plural, one {# dodatkowy język} few {# dodatkowych języków} many {# dodatkowe języki} other {# dodatkowego języka}}"

# expect: style|fluency/grammar minor
# planted: a past tense that genders the user, zostałeś wylogowany, where the style sheet wants an impersonal form such as nastąpiło wylogowanie
# hard
#: packages/app/lib/extension-swap.ts
msgid "{conflictName} was turned off, and you're signed out of it in Meru."
msgstr "Rozszerzenie {conflictName} zostało wyłączone i zostałeś z niego wylogowany w Meru."

# expect: accuracy/mistranslation|accuracy/addition major
# planted: scope widened from the compose window to every window
# hard
#: packages/renderer/routes/settings/gmail/index.tsx
msgid "Close compose window after send"
msgstr "Zamykaj wszystkie okna po wysłaniu"

# expect: accuracy/mistranslation minor
# planted: the place narrowed, the top of the message list for the top of the window
# hard
#. The out-of-office banner is the one Gmail shows while an out-of-office reply is on, so it follows Gmail's word for it
#: packages/renderer/routes/settings/gmail/index.tsx
msgid "Hide the out-of-office banner at the top of the window."
msgstr "Ukryj baner wiadomości o nieobecności u góry listy wiadomości."

# expect: accuracy/mistranslation|accuracy/omission major
# planted: the negation dropped, which inverts the option
# hard
#. Option of the Hibernate idle tabs setting: which Workspace app tabs are unloaded when idle
#: packages/shared/workspace-apps.ts
msgid "Unpinned tabs"
msgstr "Przypięte karty"

# expect: accuracy/mistranslation major
# planted: the opposite action, unread for read
# hard
#. Button on a message in the unified inbox. A Gmail action, so it follows Gmail's word for it
#: packages/renderer/routes/unified-inbox.tsx
msgid "Mark as read"
msgstr "Oznacz jako nieprzeczytane"

# expect: accuracy/mistranslation major
# planted: the select branches swapped, the window asking about this tab and the tab about this window
# hard
#. appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/dialogs.ts
msgid "{target, select, window {Open {appLabel} links in this window?} other {Open {appLabel} links in this tab?}}"
msgstr "{target, select, window {Otwierać linki aplikacji {appLabel} w tej karcie?} other {Otwierać linki aplikacji {appLabel} w tym oknie?}}"

# expect: fluency/unidiomatic|terminology minor
# planted: a calque of done for Chrome's Gotowe
# hard
#. Button that closes the dialog of an extension's sites
#: packages/renderer/routes/settings/extensions.tsx
msgid "Done"
msgstr "Zrobione"

# expect: fluency/grammar minor
# planted: the imperfective imperative on a one-off button, which takes the perfective Uruchom
# hard
#. Titlebar button that restarts Meru to install a downloaded update
#: packages/renderer/components/app-titlebar.tsx
msgid "Restart now"
msgstr "Uruchamiaj ponownie teraz"

# expect: accuracy/omission minor
# planted: the deadline dropped, before your trial ends
# hard
#: packages/renderer/routes/settings/license.tsx
msgid "Upgrade to Meru Pro before your trial ends to keep using all features."
msgstr "Zmień na Meru Pro, aby nadal korzystać ze wszystkich funkcji."

# expect: fluency/grammar minor
# planted: a singular verb, pojawi się, for the plural subject pliki
# hard
#: packages/renderer/components/download-history.tsx
msgid "Files you download appear here for 30 days."
msgstr "Pobrane pliki pojawi się tutaj przez 30 dni."

# expect: accuracy/mistranslation critical
# planted: a button that says the opposite of what it does
#: packages/renderer/routes/settings/license.tsx
msgid "Activate license key"
msgstr "Dezaktywuj klucz licencyjny"

# expect: accuracy/addition major
# planted: addition; clearing cookies would sign every account out
#. A menu or a menu item in Meru's menu bar
#: packages/app/menu.ts
msgid "Clear Cache"
msgstr "Wyczyść pamięć podręczną i pliki cookie"

# expect: accuracy/omission|accuracy/addition|accuracy/mistranslation critical
# check: catalog:placeholder dropped
# check: catalog:placeholder invented
# planted: a broken placeholder, translated
#. origin is the scheme and host of a website, such as https://example.com
#: packages/app/url.ts
msgid "Trust all links on {origin}"
msgstr "Ufaj wszystkim linkom z {pochodzenie}"

# expect: accuracy/omission|accuracy/mistranslation critical
# check: catalog:tag dropped
# planted: a broken tag, the closing </0> dropped
#. allowlistEntry is the line to add to 1Password's list of allowed browsers, which stays as it is
#: packages/renderer/routes/settings/extensions.tsx
msgid "Add <0>{allowlistEntry}</0> on its own line, then save."
msgstr "Dodaj <0>{allowlistEntry} w osobnym wierszu, a potem zapisz."

# expect: fluency/punctuation|locale-conventions minor
# check: banned:quotes
# planted: straight quotation marks for „ ”
#: packages/renderer/routes/settings/appearance.tsx
msgid "Show Do Not Disturb button"
msgstr "Pokaż przycisk \"Nie przeszkadzać\""

# expect: style minor
# check: banned:formal-address
# planted: the formal Pan for the style sheet's Ty
#: packages/renderer/routes/settings/license.tsx
msgid "Enter the license key sent to your email address after your purchase."
msgstr "Wpisz klucz licencyjny wysłany na adres e-mail Pana po zakupie."

# expect: style minor
# check: banned:lowercase-pronoun
# planted: a lowercase twojego, where the style sheet capitalizes the pronoun
#: packages/renderer/routes/settings/language-field.tsx
msgid "Gmail and Google apps follow your Google account's language."
msgstr "Gmail i aplikacje Google używają języka twojego konta Google."

# expect: locale-conventions|fluency/punctuation minor
# check: banned:one-letter-word
# planted: an ordinary space after the one-letter w, which can end a line
#. Applications is the macOS folder, so use the name the Finder shows in that language
#: packages/renderer/routes/settings/extensions.tsx
msgid "Choose Meru in the Applications folder."
msgstr "Wybierz Meru w folderze Aplikacje."

# expect: locale-conventions minor
# check: banned:unit-space
# planted: an ordinary space between the number and its unit
#. Option of the Hibernate after setting: how long a tab goes unused before it hibernates
#: packages/shared/workspace-apps.ts
msgid "30 minutes"
msgstr "30 minut"

# expect: fluency/punctuation minor
# check: banned:three-dots
# planted: three dots for the ellipsis
#. A menu or a menu item in Meru's menu bar
#: packages/app/menu.ts
msgid "Find…"
msgstr "Znajdź..."

# expect: terminology|style minor
# check: banned:restart-calque
# planted: the colloquial calque zrestartuj beside the sentence's own uruchomić ponownie
#. name is the name of a browser extension, such as Bitwarden
#: packages/app/lib/extension-window.ts
msgid "{name} starts after Meru restarts. Restart Meru, then try again."
msgstr "{name} uruchomi się po ponownym uruchomieniu Meru. Zrestartuj Meru, a potem spróbuj ponownie."

# expect: terminology minor
# check: banned:katalog
# check: pinned:folder
# planted: katalog for Chrome's folder
#: packages/renderer/routes/settings/downloads.tsx
msgid "Open folder when done"
msgstr "Otwórz katalog po zakończeniu"

# expect: terminology minor
# check: banned:uaktualnienie
# check: pinned:update
# planted: Apple's uaktualnienie, a macOS label's word, in Meru's own copy
#: packages/app/dialogs.ts
msgid "Meru couldn't check for updates."
msgstr "Meru nie może sprawdzić dostępności uaktualnień."

# expect: accuracy/untranslated major
# planted: left in English
#: packages/renderer/routes/settings/advanced.tsx
msgid "Hardware acceleration"
msgstr "Hardware acceleration"

# expect: fluency/spelling minor
# check: pinned:download-history
# planted: a typo
#: packages/renderer/routes/download-history.tsx
msgid "Download history"
msgstr "Historia pobieranai"

# expect: terminology minor
# check: pinned:extension
# planted: Firefox's Dodatki for Chrome's rozszerzenia
#. A page of Settings, named in the settings sidebar and as the page's title
#: packages/renderer/lib/settings-pages.ts
