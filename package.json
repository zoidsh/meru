{
  "name": "meru",
  "version": "4.0.0-dev.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "pnpm lint && pnpm fmt:check && pnpm types",
    "dev": "node scripts/dev.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "package": "node scripts/package.ts",
    "package:installers": "node scripts/package.ts --installers",
    "start": "node scripts/start.ts",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.ts",
    "types": "tsc && tsc -p e2e && pnpm --recursive run types"
  },
  "devDependencies": {
    "@electron/asar": "4.3.2",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "es-toolkit": "1.53.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "rolldown": "1.3.2",
    "typescript": "7.0.2",
    "ultracite": "8.2.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@12.21.0",
  "meru": {
    "appId": "sh.zoid.meru"
  },
  "productName": "Meru"
}
