{
  "name": "meru",
  "version": "4.0.0-dev.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "pnpm lint && pnpm fmt:check && pnpm types && pnpm i18n:check",
    "dev": "node scripts/dev.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "i18n:check": "lingui check sync --clean",
    "i18n:extract": "lingui extract --clean",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "measure": "node scripts/measure/index.ts",
    "package": "node scripts/package.ts",
    "package:installers": "node scripts/package.ts --installers",
    "start": "node scripts/start.ts",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.ts",
    "types": "tsc && tsc -p tsconfig.web.json && tsc -p src/preload && tsc -p e2e"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0"
  },
  "devDependencies": {
    "@lingui/cli": "6.12.0",
    "@lingui/core": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@lingui/react": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-updater": "6.8.12",
    "es-toolkit": "1.53.2",
    "lefthook": "2.2.2",
    "linkedom": "0.18.15",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.19",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "txml": "6.0.3",
    "typescript": "7.0.2",
    "ultracite": "8.2.1",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "packageManager": "pnpm@12.21.0"
}
