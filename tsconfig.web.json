{
  // The renderers: the DOM and no Node. `core`, `contract` and `i18n` are
  // checked here as well as under the main side's config, since both import
  // them.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/shell",
    "src/settings",
    "src/ui",
    "src/core",
    "src/contract",
    "src/i18n",
    "src/main/build-constants.d.ts"
  ]
}
