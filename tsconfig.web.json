{
  // The renderers: the DOM and no Node. `core`, `contract` and `i18n` are here too, since
  // both sides import them.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["src/shell", "src/ui", "src/core", "src/contract", "src/i18n"]
}
