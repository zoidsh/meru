MERU_TEST_LICENSE_KEY=op("op://Meru/Test Values/license key")
MERU_TEST_ACCOUNT_EMAIL=op("op://Meru/Google - Test Account 1/username")
# The profile is signed in by hand, once, in the main checkout, so every
# worktree names that one.
MERU_TEST_PROFILE_DIR=concat(exec(`git rev-parse --path-format=absolute --git-common-dir`), "/../.meru/e2e-signed-in")
