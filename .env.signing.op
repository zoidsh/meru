# A signed, notarised macOS build:
# `op run --env-file .env.signing.op -- bun run build:mac`.
# A signed, unnotarised arm64 DMG to test locally:
# `op run --env-file .env.signing.op -- bun run build:mac:dmg`.
CSC_LINK=op://signing/apple-developer-id-certificate/base64
CSC_KEY_PASSWORD=op://signing/apple-developer-id-certificate/password
APPLE_API_KEY=op://signing/meru-app-store-connect-key/credential
APPLE_API_KEY_ID=op://signing/meru-app-store-connect-key/username
APPLE_API_ISSUER=op://signing/meru-app-store-connect-key/issuer
APPLE_TEAM_ID=SUR5MVXA4C
APPLE_PROVISIONING_PROFILE=op://signing/meru-apple-provisioning-profile/base64
