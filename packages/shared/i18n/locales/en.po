#: packages/renderer/routes/settings/extensions.tsx
msgid "{failedCount, plural, one {Couldn't update # extension} other {Couldn't update # extensions}}"
msgstr "{failedCount, plural, one {Couldn't update # extension} other {Couldn't update # extensions}}"

#. name is the name of a browser extension, such as Bitwarden
#: packages/app/lib/extension-window.ts
msgid "{name} is running, but Meru can't open a window for it."
msgstr "{name} is running, but Meru can't open a window for it."

#. name is the name of a browser extension, such as Bitwarden
#: packages/app/lib/extension-swap.ts
msgid "{name} is still on."
msgstr "{name} is still on."

