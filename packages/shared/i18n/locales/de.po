#: packages/app/lib/extension-swap.ts
msgid "{conflictName} is off, but some of its files may be left in Meru. {extensionName} wasn't installed. Turn it on to try again."
msgstr "{conflictName} ist deaktiviert, aber Teile davon könnten noch in Meru vorhanden sein. {extensionName} wurde nicht installiert. Aktiviere {extensionName}, um es erneut zu versuchen."

#: packages/app/lib/extension-swap.ts
msgid "{conflictName} is still on, and {extensionName} wasn't installed."
msgstr "{conflictName} ist noch aktiviert, und {extensionName} wurde nicht installiert."

#: packages/app/lib/extension-swap.ts
msgid "{conflictName} was turned off, and you're signed out of it in Meru."
msgstr "{conflictName} wurde deaktiviert, und du wurdest in Meru davon abgemeldet."

#. On Linux, a finished download's notification acts when clicked; elsewhere, through its button
#: packages/renderer/routes/settings/notifications.tsx
msgid "{downloadNotificationAction, select, click {Choose what clicking the notification does.} other {Choose what the notification's button does.}}"
msgstr "{downloadNotificationAction, select, click {Wähle, was ein Klick auf die Mitteilung bewirkt.} other {Wähle, was die Taste der Mitteilung bewirkt.}}"

#. Setting that picks what a finished download's notification does: on Linux, clicking it; elsewhere, its button
#: packages/renderer/routes/settings/notifications.tsx
msgid "{downloadNotificationAction, select, click {On click} other {Button}}"
msgstr "{downloadNotificationAction, select, click {Beim Klicken} other {Taste}}"

#. Placeholder of the Color field, giving two example colors: a hex code and an rgb() value
#: packages/renderer/routes/settings/gmail/label-colors.tsx
msgid "{EXAMPLE_HEX_COLOR} or {EXAMPLE_RGB_COLOR}"
msgstr "{EXAMPLE_HEX_COLOR} oder {EXAMPLE_RGB_COLOR}"

#. extensionName is a password manager extension's name
#: packages/renderer/routes/settings/extensions.tsx
msgid "{extensionName} runs on Google's sign-in pages only. Add a site to run it there too, such as your company's single sign-on provider. Sites apply after a restart."
msgstr "{extensionName} läuft nur auf den Anmeldeseiten von Google. Füge eine Website hinzu, damit die Erweiterung auch dort läuft, etwa den Single-Sign-on-Anbieter deines Unternehmens. Websites werden nach einem Neustart übernommen."

#. Title of the dialog when more than one extension failed to update
#: packages/renderer/routes/settings/extensions.tsx
msgid "{failedCount, plural, one {Couldn't update # extension} other {Couldn't update # extensions}}"
msgstr "{failedCount, plural, one {# Erweiterung konnte nicht aktualisiert werden} other {# Erweiterungen konnten nicht aktualisiert werden}}"

#. name is the name of a browser extension, such as Bitwarden
#: packages/app/lib/extension-window.ts
msgid "{name} is running, but Meru can't open a window for it."
msgstr "{name} läuft, aber Meru kann kein Fenster dafür öffnen."

#. name is the name of a browser extension, such as Bitwarden
#: packages/app/lib/extension-swap.ts
msgid "{name} is still on."
msgstr "{name} ist noch aktiviert."

#. name is an extension's name
#: packages/renderer/routes/settings/extensions.tsx
msgid "{name} is up to date"
msgstr "{name} ist auf dem neuesten Stand"

#. name is the name of a browser extension, such as Bitwarden
#: packages/app/lib/extension-window.ts
msgid "{name} starts after Meru restarts. Restart Meru, then try again."
msgstr "{name} startet nach einem Neustart von Meru. Starte Meru neu und versuche es dann erneut."

#. name is an extension's name
#: packages/renderer/routes/settings/extensions.tsx
msgid "{name} updated to {version}"
msgstr "{name} wurde auf {version} aktualisiert"

#. name is an extension's name; reason is the technical reason, left untranslated
#: packages/renderer/routes/settings/extensions.tsx
msgid "{name}: {reason}"
msgstr "{name}: {reason}"

#. The first form is shown on Windows, the other on macOS
#: packages/app/workspace-app.ts
msgid "{platformName, select, windows {Continue with Windows Hello if you've created a passkey in Meru. Passkeys from Chrome, Google Password Manager, or your phone don't work here — sign in with your password or another second factor, then create a passkey for Meru in your Google account's security settings.} other {Continue with Touch ID if you've created a passkey in Meru. Passkeys from Chrome, iCloud, or your phone don't work here — sign in with your password or another second factor, then create a passkey for Meru in your Google account's security settings.}}"
msgstr "{platformName, select, windows {Fahre mit Windows Hello fort, wenn du in Meru einen Passkey erstellt hast. Passkeys aus Chrome, dem Google Passwortmanager oder von deinem Smartphone funktionieren hier nicht – melde dich mit deinem Passwort oder einem anderen zweiten Faktor an und erstelle dann in den Sicherheitseinstellungen deines Google-Kontos einen Passkey für Meru.} other {Fahre mit Touch ID fort, wenn du in Meru einen Passkey erstellt hast. Passkeys aus Chrome, iCloud oder von deinem Smartphone funktionieren hier nicht – melde dich mit deinem Passwort oder einem anderen zweiten Faktor an und erstelle dann in den Sicherheitseinstellungen deines Google-Kontos einen Passkey für Meru.}}"

#. The Excluded apps field once more than three apps are excluded: the names of the first three, then how many more are excluded
#: packages/renderer/routes/settings/workspace-apps.tsx
msgid "{remainingExcludedAppCount, plural, one {{visibleExcludedApps} +# excluded} other {{visibleExcludedApps} +# excluded}}"
msgstr "{remainingExcludedAppCount, plural, one {{visibleExcludedApps} und # weitere} other {{visibleExcludedApps} und # weitere}}"

#. Spellchecker languages chosen beyond the system language, counted once there are more than two to name
#: packages/renderer/routes/settings/languages.tsx
msgid "{selectedCount, plural, one {# additional language} other {# additional languages}}"
msgstr "{selectedCount, plural, one {# weitere Sprache} other {# weitere Sprachen}}"

#. Tooltip of the tab every link to a Google Workspace app opens in. tabTitle is the page's title; appName is the app's English name, such as Calendar
#: packages/renderer/components/vertical-tabs.tsx
msgid "{tabTitle} — opens {appName} links"
msgstr "{tabTitle} – öffnet Links von {appName}"

#. appLinksTabTitle is the title of the tab that opens the links today; appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/dialogs.ts
msgid "{target, select, window {“{appLinksTabTitle}” currently opens all {appLabel} links. This window will open them instead.} other {“{appLinksTabTitle}” currently opens all {appLabel} links. This tab will open them instead.}}"
msgstr "{target, select, window {„{appLinksTabTitle}“ öffnet zurzeit alle Links von {appLabel}. Künftig öffnet sie stattdessen dieses Fenster.} other {„{appLinksTabTitle}“ öffnet zurzeit alle Links von {appLabel}. Künftig öffnet sie stattdessen dieser Tab.}}"

#. Tab context menu item; appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/ipc.ts
msgid "{target, select, window {New {appLabel} Window} other {New {appLabel} Tab}}"
msgstr "{target, select, window {Neues Fenster für {appLabel}} other {Neuer Tab für {appLabel}}}"

#. appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/dialogs.ts
msgid "{target, select, window {Open {appLabel} links in this window?} other {Open {appLabel} links in this tab?}}"
msgstr "{target, select, window {Links von {appLabel} in diesem Fenster öffnen?} other {Links von {appLabel} in diesem Tab öffnen?}}"

#. Tab context menu checkbox that makes this tab open the app's links; appLabel is the name of a Google Workspace app, such as Docs or Sheets
#: packages/app/ipc.ts
msgid "{target, select, window {Open {appLabel} Links in This Window} other {Open {appLabel} Links in This Tab}}"
msgstr "{target, select, window {Links von {appLabel} in diesem Fenster öffnen} other {Links von {appLabel} in diesem Tab öffnen}}"

#. The icon is the one Meru shows in the macOS menu bar, or in the system tray elsewhere
#: packages/renderer/routes/settings/appearance.tsx
msgid "{trayLocation, select, menuBar {Automatically select the first account with unread emails when clicking the menu bar icon.} other {Automatically select the first account with unread emails when clicking the system tray icon.}}"
msgstr "{trayLocation, select, menuBar {Beim Klicken auf das Symbol in der Menüleiste automatisch den ersten Account mit ungelesenen E-Mails auswählen.} other {Beim Klicken auf das Symbol im Infobereich automatisch den ersten Account mit ungelesenen E-Mails auswählen.}}"

#. Titlebar badge counting the whole days left in the Meru Pro trial
#: packages/renderer/components/app-titlebar.tsx
msgid "{trialDaysLeft, plural, one {Pro trial ends in # day} other {Pro trial ends in # days}}"
msgstr "{trialDaysLeft, plural, one {Pro-Testzeitraum endet in # Tag} other {Pro-Testzeitraum endet in # Tagen}}"

#: packages/renderer/routes/settings/license.tsx
msgid "{trialDaysLeft, plural, one {You're using a Meru Pro trial with # day left.} other {You're using a Meru Pro trial with # days left.}}"
msgstr "{trialDaysLeft, plural, one {Du nutzt einen Meru-Pro-Testzeitraum, der noch # Tag läuft.} other {Du nutzt einen Meru-Pro-Testzeitraum, der noch # Tage läuft.}}"

#. Dialog asking to confirm switching the Workspace apps Mode setting to New windows, which says more when Workspace app tabs are open, when pinned apps load on launch, or both
#: packages/renderer/routes/settings/workspace-apps.tsx
msgid "{workspaceAppsInUse, select, both {Workspace apps open in their own window from now on. The tabs you already have open stay as they are, and the tab strip hides after you close them, or after a restart. Pinned apps set to load on launch open as windows the next time you start Meru.} openTabs {Workspace apps open in their own window from now on. The tabs you already have open stay as they are, and the tab strip hides after you close them, or after a restart.} loadOnLaunch {Workspace apps open in their own window from now on. Pinned apps set to load on launch open as windows the next time you start Meru.} other {Workspace apps open in their own window from now on.}}"
msgstr "{workspaceAppsInUse, select, both {Workspace-Apps öffnen sich ab jetzt in einem eigenen Fenster. Bereits geöffnete Tabs bleiben, wie sie sind, und die Tableiste wird ausgeblendet, sobald du sie schließt oder Meru neu startest. Fixierte Apps, die beim Start geladen werden, öffnen sich beim nächsten Start von Meru als Fenster.} openTabs {Workspace-Apps öffnen sich ab jetzt in einem eigenen Fenster. Bereits geöffnete Tabs bleiben, wie sie sind, und die Tableiste wird ausgeblendet, sobald du sie schließt oder Meru neu startest.} loadOnLaunch {Workspace-Apps öffnen sich ab jetzt in einem eigenen Fenster. Fixierte Apps, die beim Start geladen werden, öffnen sich beim nächsten Start von Meru als Fenster.} other {Workspace-Apps öffnen sich ab jetzt in einem eigenen Fenster.}}"

