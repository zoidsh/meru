# What meru's builds and tests read, all optional. Copy what you need into
# `.env`, which Bun loads for every command and git ignores.

# A signed, notarised macOS build: all seven or none.
# APPLE_API_KEY is the App Store Connect API key, as the .p8 file's contents
# or a path to it.
CSC_LINK=
CSC_KEY_PASSWORD=
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_TEAM_ID=
APPLE_PROVISIONING_PROFILE=

# A signed Windows build through Azure Artifact Signing: all three or none.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# The end-to-end suite's Pro license key, without which the Pro tests fail.
MERU_TEST_LICENSE_KEY=
# The account signed in to the end-to-end profile, and that profile's directory,
# the main checkout's `.meru/e2e-signed-in` unless set. Without both the tests
# that need them skip.
MERU_TEST_ACCOUNT_EMAIL=
MERU_TEST_PROFILE_DIR=
