{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "types": []
  },
  "files": [],
  "references": [
    { "path": "./app/core" },
    { "path": "./app/core/tsconfig.test.json" },
    { "path": "./app/shared" },
    { "path": "./app/main" },
    { "path": "./app/preload" },
    { "path": "./app/renderer" },
    { "path": "./app/test" },
    { "path": "./app/test/fakes" },
    { "path": "./packages/user-data" },
    { "path": "./tsconfig.node.json" }
  ]
}
