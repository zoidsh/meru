# A development run with seven days of trial left, whatever the date:
# `op run --env-file .env.trial.op -- bun run dev --profile trial`, on a profile
# that has never held a license key, since a valid license skips the trial.
# Never around a build, which inlines `MERU_DEV_DEVICE_ID`.
MERU_DEV_DEVICE_ID="op://dev/meru-test-license/device id"
