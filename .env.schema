# The environment of meru's build, signing and end-to-end runs. Values from
# 1Password sit in files imported only when a flag asks for them: an `op()` with
# no vault access fails the whole load, even for an optional item, and a clone,
# `bun test`, `bun run dev` and CI have none.
# @import(./.env.signing, enabled=$MERU_SIGN)
# @import(./.env.e2e, enabled=if($VARLOCK_IS_CI, false, $MERU_E2E))
# @plugin(@timche/varlock-require-all-or-none)
# @requireAllOrNone($AZURE_TENANT_ID, $AZURE_CLIENT_ID, $AZURE_CLIENT_SECRET)
# ---

# Signs and notarises a macOS build with the credentials in `.env.signing`:
# `MERU_SIGN=true bun run build:mac`. The release workflow passes them itself.
# @type=boolean @sensitive=false
MERU_SIGN=false

# Set by `test:e2e`, for the values in `.env.e2e`.
# @type=boolean @sensitive=false
MERU_E2E=false

# The Developer ID Application certificate as base64, which electron-builder
# imports into a temporary keychain of its own.
# @optional
CSC_LINK=
# @optional
CSC_KEY_PASSWORD=

# Notarisation.
# @optional
APPLE_ID=
# @optional
APPLE_APP_SPECIFIC_PASSWORD=
# Also inlined into the app, which enables Touch ID unlock only when it is set.
# @optional @sensitive=false
APPLE_TEAM_ID=
# Base64 of the provisioning profile `build/hooks/beforePack.js` writes out.
# @optional @sensitive=false
APPLE_PROVISIONING_PROFILE=

# Azure Artifact Signing, read by the Azure SDK's EnvironmentCredential. Only the
# release workflow has them, and a partial set fails the load rather than
# `build-win.ts` quietly building unsigned.
# @optional @sensitive=false
AZURE_TENANT_ID=
# @optional @sensitive=false
AZURE_CLIENT_ID=
# @optional
AZURE_CLIENT_SECRET=

# @optional
MERU_TEST_LICENSE_KEY=
# A user data directory with a Gmail account signed in, and that account's
# address. Without both the tests that need them skip.
# @optional @sensitive=false
MERU_TEST_PROFILE_DIR=
# @optional
MERU_TEST_ACCOUNT_EMAIL=
